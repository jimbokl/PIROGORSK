---
import ContentLayout from '../../layouts/ContentLayout.astro';
import ProductFacts from '../../components/ProductFacts.astro';
import ProductDisclosure from '../../components/ProductDisclosure.astro';
import PicnicSetDetails from '../../components/PicnicSetDetails.astro';
import ProductHero from '../../components/ProductHero.astro';
import PieGallery from '../../components/PieGallery.astro';
import EditorialLinks from '../../components/EditorialLinks.astro';
import ProductAddOns from '../../components/ProductAddOns.astro';
import ProductOptions from '../../components/ProductOptions.astro';
import ProductRecommendations from '../../components/ProductRecommendations.astro';
import ProductVisual from '../../components/ProductVisual.astro';
import SupplierArtwork from '../../components/SupplierArtwork.astro';
import { newPageProducts, productPage, formatWeight } from '../../data/product-pages';
import { supplierArtwork } from '../../data/supplier-artwork';
import { siteOrigin } from '../../data/editorial';
import type { Product } from '../../data/catalog';

export function getStaticPaths() {
  return newPageProducts.map(product => ({ params: { slug: product.slug.replace(/^hb-/, '') }, props: { product } }));
}
interface Props { product: Product }
const { product } = Astro.props;
const page = productPage(product);
const art = product.supplier ? supplierArtwork(product.id) : undefined;
const title = `${page.heading} — форматы и цены | Пирогорск`;
const schema = [{ '@type': 'ItemPage', '@id': `${siteOrigin}${page.href}#page`, url: `${siteOrigin}${page.href}`, name: page.heading, description: page.intro,
  ...(art ? { primaryImageOfPage: { '@type': 'ImageObject', url: `${siteOrigin}${art.ogImage}`, width: 1200, height: 630, caption: art.alt } } : {}) }];
const guide = /осетин/i.test(product.name) ? { href: '/osetinskie-pirogi/', title: 'Все осетинские пироги', text: 'Сравните начинки целых пирогов по 850 г и замороженных мини-пирогов по 210 г.', label: 'Выбор формата' } : product.category === 'mini-pies' ? { href: '/journal/skolko-piroga-na-cheloveka/', title: 'Сколько пирога нужно на человека', text: 'Считайте общий вес: один мини-пирог — 210 г, пять — 1,05 кг. Порция зависит от остального меню.', label: 'Расчёт стола' }
  : { href: '/menu/', title: 'Сравнить с остальным меню', text: 'Пироги, хлеб, выпечка и дополнения с предварительными ценами и разными форматами.', label: 'Весь ассортимент' };
---
<ContentLayout {title} description={page.description} breadcrumbs={[{ name: 'Меню', href: '/menu/' }, { name: page.heading, href: page.href }]} {schema} image={art?.ogImage} imageAlt={art?.alt} preloadFonts={false}>
  <ProductHero productId={product.id} eyebrow={`${page.group} · изучаем спрос`} title={page.heading} intro={page.intro}>
    <PieGallery slot="visual" {product} hero sizes="(max-width: 700px) min(380px, calc(100vw - 68px)), 480px">
      {art ? <SupplierArtwork id={product.id} hero /> : <ProductVisual {product} layout="hero" />}
    </PieGallery>
    <ProductOptions slot="actions" {product} showDelivery />
  </ProductHero>
  {['mini-pies', 'hearty-pies', 'sweet-pies', 'siberian-pies', 'kurniki', 'prussian-pies', 'ossetian-pies'].includes(product.category) && <ProductAddOns {product} />}
  {product.id === 'picnic-set' ? <PicnicSetDetails /> : <ProductDisclosure title="Подача и формат" id="product-details"><div class="catalog-details">
    <div class="catalog-story"><h3>К вашему столу</h3><p>{page.serving}</p><h3>Как подготовить к подаче</h3><p>{page.prep}</p>
      {page.source && !page.fresh && <p class="catalog-cold">Планируем поставку замороженного продукта с соблюдением условий хранения. Способ получения и температурный режим подтвердим перед продажами. Размороженный продукт повторно не замораживают.</p>}
    </div>
    <aside class="catalog-facts" aria-label="Формат и происхождение"><h3>Коротко о позиции</h3><dl><div><dt>Статус</dt><dd>Изучаем спрос, продажи не начались</dd></div>
      {page.source ? <><div><dt>Производитель</dt><dd>{product.supplier?.name}</dd></div><div><dt>{page.fresh ? 'Вес целого пирога' : 'Одна единица'}</dt><dd>{page.fresh ? product.variants.map(v => formatWeight(v.value)).join(' / ') : formatWeight(page.source.unitWeightG)}</dd></div><div><dt>{page.fresh ? 'Формат производителя' : 'Заводская упаковка'}</dt><dd>{page.source.sourceLabel}</dd></div><div><dt>Формат продукта</dt><dd>{product.description}</dd></div></> : <div><dt>Формат</dt><dd>{product.variants.map(v => v.label).join(' или ')}</dd></div>}
      <div><dt>Наша подборка</dt><dd>{page.fresh ? 'Целые пироги; количество можно изменить в общей подборке.' : page.source ? 'Небольшие наборы — планируемая фасовка Пирогорска из заводской упаковки.' : 'Количество можно изменить в общей подборке.'}</dd></div><div><dt>Цена и доставка</dt><dd>Предварительно. Доставка считается отдельно за всю подборку.</dd></div></dl></aside>
  </div></ProductDisclosure>}
  <ProductFacts {product} />
  <ProductRecommendations products={page.related} />
  <EditorialLinks title="Для вашего стола" links={[guide, { href: '/delivery/', title: 'Города и условия', text: 'Планируем Калининград, Зеленоградск и Светлогорск. Условия получения и цены пока предварительные.', label: 'Доставка' }]} />
</ContentLayout>
<style>
  .catalog-details{display:grid;grid-template-columns:1.15fr 1fr;gap:clamp(28px,6vw,90px);padding:0}
  .catalog-story h3,.catalog-facts h3{font:600 16px/1.5 var(--sans);margin:0 0 12px}.catalog-story h3:not(:first-child){margin-top:24px}
  .catalog-story p{font-size:14px;line-height:1.8;max-width:76ch}.catalog-cold{color:var(--ed-muted)}
  .catalog-facts{border:1px solid var(--ed-line);border-radius:14px;padding:26px;align-self:start}.catalog-facts dl{margin:0}.catalog-facts dl>div{padding:12px 0;border-top:1px solid var(--ed-line)}.catalog-facts dt{font-size:11px;color:var(--ed-muted);margin-bottom:5px}.catalog-facts dd{margin:0;font-size:13px;line-height:1.65}
  @media(max-width:760px){.catalog-details{grid-template-columns:1fr;gap:24px}.catalog-facts{padding:20px}}
</style>
