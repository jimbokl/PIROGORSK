---
import ProductVisual from '../components/ProductVisual.astro';
import ContentLayout from '../layouts/ContentLayout.astro';
import EditorialHero from '../components/EditorialHero.astro';
import EditorialInterest from '../components/EditorialInterest.astro';
import EditorialLinks from '../components/EditorialLinks.astro';
import SupplierCatalog from '../components/SupplierCatalog.astro';
import { extras } from '../data/catalog';
import { productPage } from '../data/product-pages';
import { catalogProductHref } from '../lib/product-paths';
import { editorialProducts, productHref, scenarios, conceptCaption } from '../data/editorial';
const title = 'Меню — целые пироги, хлеб и выпечка | Пирогорск';
const description = '153 позиции перед запуском Пирогорска: 61 пирог а-ля Русс, 78 продуктов Holland Bakery, наши идеи и дополнения. Сравните форматы и предварительные цены, отметьте интерес.';
---
<ContentLayout {title} {description} breadcrumbs={[{ name: 'Меню', href: '/menu/' }]}>
  <EditorialHero eyebrow="153 позиции · готовим запуск" title="Меню пирогов, хлеба и выпечки" intro="Начинаем с подбора выпечки местных пекарен и доставки через Пирогорск. Сохранили первые восемь идей пирогов, добавили 61 целый пирог «Пироги а-ля Русс», 78 позиций Holland Bakery и шесть напитков и дополнений. Цены и форматы предварительные." />
  <div class="ed-note"><strong>Сейчас проверяем интерес.</strong> Продажи и производство ещё не запущены. {conceptCaption} Состав и аллергены опубликуем до начала заказов.</div>
  <p class="menu-planner-link"><a href="/podbor/">Сколько пирогов нужно на вашу компанию? Рассчитать вес ↗</a></p>
  <section class="ed-catalog" id="pirogi" aria-label="Концепты пирогов">{editorialProducts.map(product => <article class="ed-product-card"><a class="product-visual-link" href={productHref(product)}><ProductVisual {product} layout="menu" /><p class="ed-eyebrow">{product.sweet ? 'К чаю' : 'К общему столу'} · концепт</p><h2>{product.name}</h2><p>{product.editorial.intro}</p><span class="ed-product-more">О вкусе и статусе рецепта ↗</span></a></article>)}</section>
  <SupplierCatalog fresh interactive={false} />
  <SupplierCatalog interactive={false} />
  <section id="extras" class="ed-links-section menu-extras" aria-labelledby="menu-extras-title">
    <h2 id="menu-extras-title">Напитки и дополнения</h2>
    <div class="ed-catalog">{extras.map(product => <article class="ed-product-card"><a class="product-visual-link" href={catalogProductHref(product)}><ProductVisual {product} layout="menu" decorative /><p class="ed-eyebrow">От {Math.min(...product.variants.map(v => v.price)).toLocaleString('ru-RU')} ₽ · предварительно</p><h3>{product.name}</h3><p>{productPage(product).intro}</p><span class="ed-product-more">Подробнее о позиции ↗</span></a></article>)}</div>
  </section>
  <EditorialInterest interest="menu" title="Какие пироги вам интересны?" text="На главной можно собрать анонимную подборку и отметить город. Это поможет нам оценить спрос перед запуском; заказ и оплата пока недоступны." label="Выбрать интересные пироги" />
  <EditorialLinks title="Собираете стол к случаю?" links={scenarios.map(item => ({ href: `/nabor/${item.slug}/`, title: item.title, text: item.intro, label: 'Сценарий' }))} />
</ContentLayout>
<style>.menu-planner-link{margin:25px 0;font-size:13px;line-height:1.8}.menu-planner-link a{display:inline-block;min-height:44px;padding-block:10px;text-underline-offset:4px}.menu-extras h3{font-size:clamp(23px,2.2vw,28px);line-height:1.2;margin-top:7px}</style>
