---
import CatalogFillings from '../components/CatalogFillings.astro';
import HomeOffers from '../components/HomeOffers.astro';
import MenuFeedItem from '../components/MenuFeedItem.astro';
import ContentLayout from '../layouts/ContentLayout.astro';
import PieTownHero from '../components/PieTownHero.astro';
import town from '../../design/pie-city-banners-20261030/pie-city.png';
import EditorialInterest from '../components/EditorialInterest.astro';
import EditorialLinks from '../components/EditorialLinks.astro';
import SupplierCatalog from '../components/SupplierCatalog.astro';
import { catalog, extras } from '../data/catalog';
import { freshProducts } from '../data/pirogi39-catalog';
import { supplierProducts } from '../data/holland-catalog';
import '../styles/menu.css';
import { editorialProducts, scenarios } from '../data/editorial';
const sections = [
  { id: 'pirogi39', title: 'Целые пироги', text: 'Готовые пироги в весах производителя', count: freshProducts.length },
  { id: 'holland', title: 'Выпечка и мини-пироги', text: 'Замороженные продукты и заготовки', count: supplierProducts.length },
  { id: 'pirogi', title: 'Идеи Пирогорска', text: 'Восемь концептов · 500 г и 1 кг', count: editorialProducts.length },
  { id: 'extras', title: 'К столу', text: 'Напитки и посуда', count: extras.length },
];
const feedPrices = catalog.map(({id, name, variants}) => ({id, name, variants}));
const title = 'Меню — целые пироги, хлеб и выпечка | Пирогорск';
const description = `${catalog.length} позиции перед запуском Пирогорска: 61 пирог а-ля Русс, 78 продуктов Holland Bakery, наши идеи и дополнения. Сравните форматы и предварительные цены, отметьте интерес.`;
---
<ContentLayout {title} {description} bodyClass="menu-page" breadcrumbs={[{ name: 'Меню', href: '/menu/' }]}>
  <PieTownHero image={town} imageAlt="Пироговый город: золотистые балтийские домики на пироге у синих волн" eyebrow={`${catalog.length} позиции · готовим запуск`} title="Меню пирогов, хлеба и выпечки" intro="Целые пироги, мини-форматы, хлеб и сладкое от местных пекарен. Выбирайте начинки и собирайте свой стол." />
  <form class="menu-finder" role="search" aria-label="Поиск по всему меню" data-menu-finder>
    <label for="menu-search">Что хочется попробовать?</label>
    <div class="menu-search-row"><input id="menu-search" type="search" name="q" maxlength="100" data-menu-search data-catalog-query placeholder="Начинка, название или вес" autocomplete="off" enterkeyhint="search" /><button class="ed-button" type="submit">Найти</button></div>
    <CatalogFillings />
    <div class="menu-search-meta"><p data-menu-status role="status" aria-live="polite" aria-atomic="true">В меню {catalog.length} позиции</p><button type="button" data-menu-reset data-catalog-reset hidden>Сбросить поиск и фильтры</button></div>
    <p class="menu-stage">Предварительные цены · подборка до запуска, ещё не заказ.</p>
  </form>
  <nav class="menu-sections" aria-label="Разделы меню">{sections.map(section => <a href={`#${section.id}`} data-menu-jump={section.id}><strong>{section.title}</strong><small>{section.text}</small><span><b data-menu-section-count>{section.count}</b></span></a>)}</nav>
  <div class="menu-empty" data-menu-empty hidden><h2>Такого вкуса пока не нашлось</h2><p>Попробуйте часть названия или другую начинку. Например, «вишня», «сыр» или «рыба».</p><button type="button" class="ed-button" data-menu-empty-reset data-catalog-empty-reset>Показать всё меню</button></div>
  <p class="menu-planner-link"><a href="/podbor/">Рассчитать на компанию ↗</a><a href="#nabory">Готовые сочетания ↗</a></p>
  <div class="menu-feed">
  <SupplierCatalog fresh interactive={false} feed />
  <SupplierCatalog interactive={false} feed />
  <section class="menu-originals" id="pirogi" data-menu-section aria-labelledby="menu-originals-title">
    <header><p class="ed-eyebrow">Первые восемь идей</p><h2 id="menu-originals-title">Пироги Пирогорска</h2><p>Наши концепты для будущего меню, отдельно от ассортимента пекарен. Планируем два размера: 500 г и 1 кг. Рецепты ещё разрабатываются.</p></header>
    <div class="menu-feed-list">{editorialProducts.map(product => <MenuFeedItem {product} concept />)}</div>
  </section>
  <section id="extras" data-menu-section class="ed-links-section menu-extras" aria-labelledby="menu-extras-title">
    <h2 id="menu-extras-title">Напитки и дополнения</h2>
    <div class="menu-feed-list">{extras.map(product => <MenuFeedItem {product} />)}</div>
  </section>
  </div>
  <HomeOffers embedded />
  <aside class="menu-feed-notice" data-feed-feedback hidden aria-label="Ваша подборка"><p role="status" aria-live="polite" data-feed-message></p><a href="/?interest=selection" data-feed-selection data-open="selection-dialog">Открыть подборку</a><button type="button" class="menu-feedback-close" data-feed-dismiss aria-label="Скрыть уведомление о подборке">×</button></aside>
  <script type="application/json" id="menu-feed-catalog" set:html={JSON.stringify(feedPrices).replaceAll("<", "\\u003c")} />
  <EditorialInterest interest="menu" title="Какие пироги вам интересны?" text="На главной можно собрать анонимную подборку и отметить город. Это поможет нам оценить спрос перед запуском; заказ и оплата пока недоступны." label="Выбрать интересные пироги" />
  <EditorialLinks title="Собираете стол к случаю?" links={scenarios.map(item => ({ href: `/nabor/${item.slug}/`, title: item.title, text: item.intro, label: 'Сценарий' }))} />
  <script>import '../scripts/menu-finder'; import '../scripts/menu-feed';</script>
</ContentLayout>
<style>.menu-planner-link{margin:25px 0;font-size:13px;line-height:1.8}.menu-planner-link a{display:inline-block;min-height:44px;padding-block:10px;text-underline-offset:4px}.menu-extras h3{font-size:clamp(23px,2.2vw,28px);line-height:1.2;margin-top:7px}</style>
