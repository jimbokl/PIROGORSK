---
import CatalogFillings from '../components/CatalogFillings.astro';
import Icon from '../components/Icon.astro';
import ProductCard from '../components/ProductCard.astro';
import HomeDepartments from '../components/HomeDepartments.astro';
import HomeOffers from '../components/HomeOffers.astro';
import SelectionUI from '../components/SelectionUI.astro';
import { bundles } from '../data/bundles';
import { selectionPrice } from '../lib/selection-offers';
import Analytics from '../components/Analytics.astro';
import SeoHead from '../components/SeoHead.astro';
import Brand from '../components/Brand.astro';
import SiteHeader from '../components/SiteHeader.astro';
import TownSignature from '../components/TownSignature.astro';
import BlogCards from '../components/BlogCards.astro';
import { blogEntries } from '../data/blog';
import { catalog } from '../data/catalog';
import { homeCatalogGroups } from '../data/home-catalog';
import TastingHero from '../components/TastingHero.astro';
import '../styles/global.css';
import '../styles/home.css';
import '../styles/site-ui.css';
import '../styles/menu.css';
import '../styles/brand-details.css';
const faqs = [
  ['Можно уже заказать пирог?', 'Мы готовим запуск. Сейчас можно выбрать пироги и оставить анонимную заявку по предварительной цене. Это поможет определить меню и города. Заказ и оплата пока не подтверждаются.'],
  ['Чем отличаются 500 г и 1 кг?', 'Это два варианта веса одного пирога. Можно взять несколько небольших пирогов с разными начинками или большой пирог к общему столу. Вес готового продукта уточним перед открытием.'],
  ['Что добавилось в ассортимент?', 'К восьми первым идеям и шести дополнениям добавили 61 целый пирог «Пироги а-ля Русс» и 78 позиций Holland Bakery: мини-пироги, хлеб, десерты, замороженные заготовки и тесто. Веса и формы поставщиков отмечены отдельно; наличие и условия подтвердим до продаж.'],
  ['Сколько будет стоить доставка?', 'Для проверки спроса считаем доставку один раз за всю подборку: ориентир 350 ₽ по Калининграду, 500 ₽ по Зеленоградску и 650 ₽ по Светлогорску. Это расчётные суммы, а не подтверждённые тарифы курьера. Адреса, интервалы и окончательные условия появятся до начала продаж.'],
  ['Нужно оставлять телефон?', 'Нет. Заявка анонимная: мы сохраняем город, выбранные товары, количество, желаемый день и способ получения. Связаться с вами по такой заявке не получится.'],
];
const faqSchema = { '@type': 'FAQPage', mainEntity: faqs.map(([name,text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) };
---
<!doctype html>
<html lang="ru">
  <head>
    <!-- Inline font-face + optional lets the first frame render while the fonts load.
         Preloading all four subsets delayed the hero's first frame in Chrome 153. -->
    <SeoHead title="Пирогорск — пироги в Зеленоградске, Калининграде и Светлогорске" description="Пироги с балтийским характером: целые и мини-пироги, хлеб, десерты и наборы к общему столу. Посмотрите меню и соберите подборку с расчётом доставки. Готовим запуск." canonicalPath="/" schema={[faqSchema]} preloadFonts={false} />
  </head>
  <body class="home-page">
    <a class="skip-link" href="#pirogi">Перейти к пирогам</a>
    <SiteHeader home />
    <main id="top">
      <TastingHero />
      <section class="catalog home-featured container" id="pirogi" aria-labelledby="catalog-heading">
        <div class="home-section-heading"><h2 id="catalog-heading">Выберите свой пирог</h2><a href="/menu/">Всё меню · {catalog.length}<Icon name="arrow" /></a></div>
        <p class="home-planner-link"><a href="/podbor/">Сколько пирогов на компанию? <Icon name="arrow" /></a></p>
          <form class="home-finder" role="search" aria-label="Поиск по всему ассортименту" data-home-finder action="/menu/">
            <label for="home-search">Найдите любимый вкус</label>
            <div class="home-search-row"><input id="home-search" type="search" name="q" maxlength="100" data-catalog-query autocomplete="off" placeholder="Начинка или название" enterkeyhint="search" /><button type="submit">Найти</button></div>
            <CatalogFillings />
            <div class="home-search-meta"><p data-home-filter-status role="status" aria-live="polite">В меню {catalog.length} позиции</p><button type="button" data-catalog-reset hidden>Сбросить фильтры</button></div>
          </form>
          <div class="home-catalog-empty" data-home-empty hidden><p>Такого вкуса пока не нашлось. Попробуйте другую начинку или часть названия.</p><button type="button" data-catalog-empty-reset>Показать всё меню</button></div>
        <nav class="home-menu-shortcuts home-catalog-nav" aria-label="Разделы меню" data-home-catalog-nav>
          {homeCatalogGroups.map(group => <a href={`#${group.id}`} data-home-category={group.id}>{group.label}<span>{group.products.length}</span></a>)}
          <a href="#nabory">Наборы</a>
        </nav>
        <div class="home-product-feed" data-home-catalog>
          {homeCatalogGroups.map((group, groupIndex) => <section class="home-catalog-group" id={group.id} data-home-group aria-labelledby={`heading-${group.id}`}>
            <header class="home-catalog-heading"><h3 id={`heading-${group.id}`}>{group.label}</h3><span>{group.products.length} поз.</span></header>
            <div class="menu-feed-list">{group.products.map((product, i) => <ProductCard product={product} feed priority={groupIndex === 0 && i === 0} />)}</div>
          </section>)}
        </div>
        <div class="home-catalog-more" data-home-more-wrap hidden><p data-home-catalog-status role="status" aria-live="polite"></p><button type="button" class="button" data-home-more>Показать ещё</button></div>
      </section>
      <p class="home-status container"><span>Готовим запуск</span> Выбирайте вкусы и отмечайте интерес. Цены предварительные, заказ и оплата пока недоступны.</p>
      <HomeDepartments />
      <HomeOffers />
      <section class="discovery container" aria-labelledby="discovery-heading">
        <div><h2 id="discovery-heading">Пироги в балтийских городах</h2><p>Пироги после прогулки у моря, к ужину в апартаментах или встрече с друзьями. Изучаем спрос в трёх городах — выберите свой.</p></div>
        <nav class="discovery-cities" aria-label="Пироги по городам"><a href="/zelenogradsk/">Зеленоградск<Icon name="arrow" /></a><a href="/kaliningrad/">Калининград<Icon name="arrow" /></a><a href="/svetlogorsk/">Светлогорск<Icon name="arrow" /></a></nav>
      </section>
      <section class="home-journal container" aria-labelledby="journal-heading"><header><div><h2 id="journal-heading">Блог Пирогорска</h2></div><a href="/blog/">Все материалы<Icon name="arrow" /></a></header><BlogCards entries={blogEntries.slice(0, 3)} /></section>
      <section class="home-faq container" aria-labelledby="faq-heading"><div><h2 id="faq-heading">Перед первым пирогом</h2><a class="home-partner-link" href="/partners/">Владельцам апартаментов и пекарням<Icon name="arrow" /></a></div><div class="home-faq-list">{faqs.map(([question,answer]) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></section>
    </main>
    <footer class="site-footer container">
      <TownSignature />
      <div class="footer-main">
        <Brand href="#top" footer />
        <nav aria-label="Выберите город" class="footer-cities">{['Калининград', 'Светлогорск', 'Зеленоградск'].map(city => <button data-select-city={city}>{city}</button>)}</nav>
        <span class="footer-domain"><Icon name="wave" />pirogorsk.ru</span>
      </div>
      <nav class="footer-info home-footer-links" aria-label="О Пирогорске"><a href="/delivery/">Доставка</a><a href="/about/">О проекте</a><a href="/menu/">Всё меню</a><a href="/podbor/">Сколько пирогов?</a><a href="/povody/">К случаю</a><a href="/blog/">Блог</a><a href="/partners/">Партнёрам</a><a href="/privacy/">О данных</a><a href="/terms/">Условия</a></nav>
      <p class="launch-note">Готовимся к открытию. Меню и цены предварительные. Можно оставить анонимную заявку. Приём заказов и оплата пока не открыты.</p>
    </footer>

    <dialog id="bundle-dialog" class="dialog bundle-dialog" aria-labelledby="bundle-dialog-heading">
      <div class="dialog-header"><span class="eyebrow">Вместе вкуснее</span><button data-close class="icon-button" aria-label="Закрыть наборы"><Icon name="close" /></button></div>
      <h2 id="bundle-dialog-heading">На всех хватит</h2><p class="dialog-intro">Начните с набора — состав и количество можно изменить в подборке.</p>
      {bundles.map(bundle => <div><button class="preset-option" data-preset={bundle.id}><span><strong>{bundle.title}</strong><small>{bundle.items.map(item => { const product = catalog.find(product => product.id === item.id)!; return `${product.name} · ${product.variants.find(variant => variant.value === item.value)!.label}`; }).join(' + ')}</small></span><span>{selectionPrice(bundle.items, catalog).toLocaleString('ru-RU')} ₽<Icon name="arrow" /></span></button><a class="text-button" href={`/?interest=edit-bundle&bundle=${bundle.id}`} data-edit-bundle={bundle.id}>Изменить состав<Icon name="arrow" /></a></div>)}
      <button class="text-button" data-custom-bundle>Соберу свой набор<Icon name="arrow" /></button>
    </dialog>
    <dialog id="delivery-dialog" class="dialog info-dialog" aria-labelledby="delivery-heading">
      <div class="dialog-header"><span class="eyebrow" data-city>Зеленоградск</span><button data-close class="icon-button" aria-label="Закрыть информацию о доставке"><Icon name="close" /></button></div>
      <h2 id="delivery-heading">К вашему столу</h2><p class="dialog-intro">Готовим подборку выпечки из местных пекарен с доставкой через Пирогорск.</p><p>Расчётные ориентиры за одну доставку: Калининград — 350 ₽, Зеленоградск — 500 ₽, Светлогорск — 650 ₽. Это рабочая оценка для проверки спроса. Зоны, интервалы, условия перевозки замороженной продукции и тарифы подтвердим перед продажами.</p><button class="button" data-go-catalog>Выбрать пирог<Icon name="arrow" /></button>
    </dialog>
    <dialog id="about-dialog" class="dialog info-dialog" aria-labelledby="about-heading">
      <div class="dialog-header"><span class="eyebrow">Пирогорск</span><button data-close class="icon-button" aria-label="Закрыть информацию о проекте"><Icon name="close" /></button></div>
      <h2 id="about-heading">С балтийским характером</h2><p class="dialog-intro">Пирог, за которым хочется собраться.</p><p>Начинаем с подбора ассортимента местных пекарен и изучения спроса на доставку. Первые восемь идей пирогов остаются; рядом — 61 целый пирог «Пироги а-ля Русс» и 78 позиций Holland Bakery.</p><p>Поставки пока не согласованы. Сейчас можно оставить анонимную заявку по расчётной цене.</p><button class="button" data-go-catalog>Посмотреть пироги<Icon name="arrow" /></button>
    </dialog>
    <SelectionUI />
    <Analytics />
    <script>import '../scripts/home-catalog.ts';</script>
  </body>
</html>
