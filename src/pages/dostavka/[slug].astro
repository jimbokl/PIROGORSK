---
import { locations } from '../../data/editorial';
export function getStaticPaths() {
  return locations.map(item => ({ params: { slug: item.slug }, props: { item } }));
}
interface Props { item: (typeof locations)[number] }
const { item } = Astro.props;
const target = `/${item.slug}/`;
// GitHub Pages is static: an immediate meta refresh is the permanent redirect
// supported by this host. Keep a canonical and a usable link without JavaScript.
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{item.heading} — новый адрес | Пирогорск</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={`https://pirogorsk.ru${target}`} />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <script is:inline define:vars={{ target }}>location.replace(target + location.search + location.hash);</script>
  </head>
  <body><main><h1>{item.heading}</h1><p>Страница переехала. <a href={target}>Перейти к меню и планам доставки</a>.</p></main></body>
</html>
