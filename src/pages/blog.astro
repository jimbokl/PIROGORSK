---
import { Picture } from 'astro:assets';
import LcpImagePreload from '../components/LcpImagePreload.astro';
import ContentLayout from '../layouts/ContentLayout.astro';
import BlogCards from '../components/BlogCards.astro';
import EditorialInterest from '../components/EditorialInterest.astro';
import { blogEntries, blogCategories, articleHref } from '../data/blog';
import { siteOrigin } from '../data/editorial';
import '../styles/blog.css';
const featured = blogEntries[0];
const schema = [{ '@type': 'Blog', '@id': `${siteOrigin}/blog/#blog`, name: 'Блог Пирогорска', url: `${siteOrigin}/blog/`, inLanguage: 'ru-RU', publisher: { '@id': `${siteOrigin}/#organization` }, blogPost: blogEntries.map(entry => ({ '@type': 'BlogPosting', headline: entry.title, url: `${siteOrigin}${articleHref(entry.slug)}` })) }];
---
<ContentLayout title="Блог Пирогорска — пироги и еда в Зеленоградске и Светлогорске" description="Сколько пирога взять на компанию, как выбрать 500 г или 1 кг и что подать к чаю. Таблицы, калькулятор и гиды по кафе Зеленоградска и Светлогорска." breadcrumbs={[{ name: 'Блог', href: '/blog/' }]} {schema}>
  <LcpImagePreload slot="head" src={featured.image} widths={[360, 480, 680, 960, 1200]} sizes="(max-width: 760px) calc(100vw - 36px), (min-width: 1240px) 660px, 55vw" width={900} height={600} quality={48} />
  <header class="blog-heading"><div><p class="ed-eyebrow">Блог Пирогорска · {blogEntries.length} материалов</p><h1>К общему<br /><em>столу</em></h1></div><p>Сколько взять, с чем подать, где поесть после моря. Разбираем вопросы, с которых начинается хороший ужин.</p></header>
  <section class="blog-feature" aria-labelledby="feature-title">
    <a class="blog-feature-image" href={articleHref(featured.slug)} aria-label={`Читать: ${featured.title}`}><Picture src={featured.image} formats={['avif', 'webp']} fallbackFormat="webp" widths={[360, 480, 680, 960, 1200]} sizes="(max-width: 760px) calc(100vw - 36px), (min-width: 1240px) 660px, 55vw" width={900} height={600} quality={48} alt={featured.imageAlt} loading="eager" fetchpriority="high" decoding="sync" /></a>
    <div class="blog-feature-copy"><span class="blog-feature-number" aria-hidden="true">01</span><p class="ed-eyebrow">{featured.category} · ≈ {featured.minutes} мин</p><h2 id="feature-title"><a href={articleHref(featured.slug)}>{featured.title}</a></h2><p>Четыре гостя или двенадцать? Посчитаем общий вес, разделим его между начинками и не прибавим запас дважды.</p><a class="blog-text-link" href={articleHref(featured.slug)}>Открыть таблицу<span aria-hidden="true">↗</span></a></div>
  </section>
  <p class="blog-image-note">Обложки созданы с помощью ИИ для иллюстрации материалов. Это не фотографии готовой продукции.</p>
  <nav class="blog-topics" aria-label="Темы блога"><span>О чём почитать</span>{blogCategories.map(category => <a href={`#${category.id}`}>{category.name}<small>{blogEntries.filter(entry => entry.category === category.name).length}</small></a>)}</nav>
  {blogCategories.map(category => <section class="blog-category" id={category.id} aria-labelledby={`${category.id}-title`}><header><h2 id={`${category.id}-title`}>{category.name}</h2><p>{category.description}</p></header><BlogCards entries={blogEntries.filter(entry => entry.category === category.name && entry.slug !== featured.slug)} /></section>)}
  <EditorialInterest interest="blog" title="А какой пирог выбрали бы вы?" text="Пирогорск готовится к запуску. Изучаем интерес к начинкам, форматам и трём балтийским городам. Можно собрать предварительную подборку без телефона и оплаты." label="Выбрать начинки" />
</ContentLayout>
