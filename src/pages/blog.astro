---
import { Picture } from 'astro:assets';
import PieTownHero from '../components/PieTownHero.astro';
import town from '../../design/pie-city-site-20261030/journal-town.png';
import ContentLayout from '../layouts/ContentLayout.astro';
import BlogCards from '../components/BlogCards.astro';
import EditorialInterest from '../components/EditorialInterest.astro';
import { blogEntries, blogCategories, articleHref } from '../data/blog';
import { siteOrigin } from '../data/editorial';
import '../styles/blog.css';
const featured = blogEntries.find(entry => entry.slug === 'kak-sravnit-tseny-na-pirogi')!;
const otherCategories = blogCategories.map(category => ({ ...category, entries: blogEntries.filter(entry => entry.category === category.name && entry.slug !== featured.slug) })).filter(category => category.entries.length > 0);
const schema = [{ '@type': 'Blog', '@id': `${siteOrigin}/blog/#blog`, name: 'Блог Пирогорска', url: `${siteOrigin}/blog/`, inLanguage: 'ru-RU', publisher: { '@id': `${siteOrigin}/#organization` }, blogPost: blogEntries.map(entry => ({ '@type': 'BlogPosting', headline: entry.title, url: `${siteOrigin}${articleHref(entry.slug)}` })) }];
---
<ContentLayout bodyClass="blog-page" title="Блог Пирогорска — пироги и еда в Калининграде и на побережье" description="Начинки, тесто, выпечка, хранение и сервировка пирогов. Таблицы, расчёты и гиды для общего стола в Калининграде и на побережье." breadcrumbs={[{ name: 'Блог', href: '/blog/' }]} {schema}>
  <PieTownHero eyebrow={`Журнал пирогового города · ${blogEntries.length} материалов`} title="К общему столу" intro="Начинки и тесто, хрустящая корочка и общий стол. Разбираем, как выбрать пирог, сравнить цены и подать угощение для своей компании." image={town} imageAlt="Пироговый город на страницах раскрытой книги, пирог и балтийские волны" />
  <section class="blog-feature" aria-labelledby="feature-title">
    <a class="blog-feature-image" href={articleHref(featured.slug)} aria-label={`Читать: ${featured.title}`}><Picture src={featured.image} formats={['avif', 'webp']} fallbackFormat="webp" widths={[360, 480, 680, 960, 1200]} sizes="(max-width: 760px) calc(100vw - 36px), (min-width: 1240px) 660px, 55vw" width={900} height={600} quality={48} alt={featured.imageAlt} loading="lazy" fetchpriority="low" decoding="async" /></a>
    <div class="blog-feature-copy"><span class="blog-feature-number" aria-hidden="true">01</span><p class="ed-eyebrow">{featured.category} · ≈ {featured.minutes} мин</p><h2 id="feature-title"><a href={articleHref(featured.slug)}>{featured.title}</a></h2><p>{featured.description}</p><a class="blog-text-link" href={articleHref(featured.slug)}>Сравнить по делу<span aria-hidden="true">↗</span></a></div>
  </section>
  <nav class="blog-topics" aria-label="Темы блога"><span>Ещё почитать</span>{otherCategories.map(category => <a href={`#${category.id}`}>{category.name}<small>{category.entries.length}</small></a>)}</nav>
  {otherCategories.map(category => <section class="blog-category" id={category.id} aria-labelledby={`${category.id}-title`}><header><h2 id={`${category.id}-title`}>{category.name}</h2><p>{category.description}</p></header><BlogCards entries={category.entries} /></section>)}
  <EditorialInterest interest="blog" title="А какой пирог выбрали бы вы?" text="Пирогорск готовится к запуску. Изучаем интерес к начинкам, форматам и трём балтийским городам. Можно собрать предварительную подборку без телефона и оплаты." label="Выбрать начинки" />
</ContentLayout>
