---
import ContentLayout from '../layouts/ContentLayout.astro';
import EditorialHero from '../components/EditorialHero.astro';
import EditorialBody from '../components/EditorialBody.astro';
import EditorialInterest from '../components/EditorialInterest.astro';
import EditorialLinks from '../components/EditorialLinks.astro';
import { editorialImages, guides } from '../data/editorial';
import { foodGuide } from '../data/food-guides';
const title = 'О Пирогорске — пироги с балтийским характером';
const description = 'Пирогорск — проект пирогов для ужинов и встреч у Балтики. Честно о подготовке: концепты меню, иллюстрации, проверка интереса и будущие условия.';
---
<ContentLayout {title} {description} breadcrumbs={[{ name: 'О проекте', href: '/about/' }]}>
  <EditorialHero eyebrow="Пирогорск · о проекте" title="Пироги с балтийским характером" intro="Пирогорск начинается с идеи общего стола у моря: ужина в апартаментах, встречи друзей, чая после прогулки. Сейчас разрабатываем проект и проверяем, какие вкусы и форматы нужны людям." image={editorialImages.hero} imageAlt="Концепт пирога с рисунками маяка, волн и рыбы" />
  <EditorialBody sections={[
    { title: 'Что уже есть', paragraphs: ['Есть название, визуальная идея и концепты сытных и сладких пирогов. Есть три направления, интерес к которым хотим проверить: Зеленоградск, Калининград и Светлогорск. На сайте можно рассмотреть меню и собрать анонимную подборку.', 'Изображения созданы для разработки визуального образа. Они не показывают выпущенную партию и не доказывают состав. Внешний вид готовых изделий может измениться после работы над рецептурами.'] },
    { title: 'Что ещё впереди', paragraphs: ['Производство и продажи пока не запущены. Рецепты, поставщики, точный состав, аллергены, веса и окончательные цены ещё предстоит утвердить. Затем понадобятся проверенные условия хранения, подачи, заказа и доставки.', 'Мы не указываем вымышленный адрес пекарни и часы работы. Реквизиты и контакты для заказов появятся, когда будут готовы продукт и порядок продаж.'] },
    { title: 'Зачем сейчас выбирать пироги', paragraphs: ['Ваш выбор помогает понять, какие вкусы и сценарии стоит разрабатывать первыми. Подборка показывает интерес; она не создаёт заказ, бронь или обязанность оплатить.', 'Для этого этапа не нужны телефон, электронная почта или адрес. Можно отметить город и предпочтения анонимно.'] },
  ]} />
  <EditorialInterest interest="about" title="Помогите выбрать будущее меню" text="Посмотрите вкусы и соберите свою подборку на главной. Участие анонимное; производство и приём заказов ещё впереди." label="Выбрать интересные вкусы" />
  <EditorialLinks id="guides" title="Заметки к общему столу" links={[{ href: `/journal/${foodGuide.slug}/`, title: foodGuide.title, text: foodGuide.description, label: 'Меню кафе' }, ...guides.map(item => ({ href: `/journal/${item.slug}/`, title: item.title, text: item.description, label: 'Практический гид' }))]} />
</ContentLayout>
