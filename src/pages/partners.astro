---
import ContentLayout from '../layouts/ContentLayout.astro';
import PieTownHero from '../components/PieTownHero.astro';
import town from '../../design/pie-city-banners-20261030/pie-islands.png';
import EditorialBody from '../components/EditorialBody.astro';
import EditorialInterest from '../components/EditorialInterest.astro';
import EditorialLinks from '../components/EditorialLinks.astro';
const title = 'Владельцам апартаментов — идея сотрудничества | Пирогорск';
const description = 'Пирогорск изучает формат пирогов для гостей апартаментов. Что потребуется для сотрудничества и какие условия пока не утверждены.';
---
<ContentLayout {title} {description} breadcrumbs={[{ name: 'Партнёрам', href: '/partners/' }]}>
  <PieTownHero eyebrow="Владельцам апартаментов" title="Ужин для гостей — идея для будущего запуска" intro="Если вы принимаете гостей у моря, вопрос еды в день приезда вам знаком. Изучаем формат пирогов для ужина в апартаментах и хотим понять, нужен ли он хозяевам и гостям." image={town} imageAlt="Пироговый город с островами сытных и сладких пирогов для общего стола" />
  <EditorialBody sections={[
    { title: 'Какой формат рассматриваем', paragraphs: ['Гость мог бы заранее посмотреть меню, узнать подтверждённые условия и самостоятельно выбрать еду. Для хозяина это могло бы стать ещё одной полезной подсказкой в памятке к заселению. Пока это идея: действующей партнёрской программы нет.', 'QR-код или ссылка имеют смысл после запуска заказа и проверки доставки к конкретному жилью. Сейчас нельзя обещать гостям работающую услугу или определённое время приезда.'] },
    { title: 'Что важно проверить вместе', items: ['Город, расположение жилья и возможность обслуживать конкретный адрес.', 'Понятный вход и способ передачи еды гостю.', 'Время заселения, наличие посуды и техники в квартире.', 'Условия ссылки или QR-кода и понятный для гостя порядок заказа.'] },
    { title: 'Условия ещё предстоит согласовать', paragraphs: ['Комиссии, скидки, бесплатные пироги и другие вознаграждения не утверждены. Мы не используем их как обещание сотрудничества. Сначала нужно подтвердить сам продукт, производство, доставку и удобство для гостей.', 'Сейчас можно анонимно отметить интерес к этому направлению. Контакты для переговоров и подробные условия появятся отдельно, когда будет что обсуждать предметно.'] },
  ]} />
  <EditorialInterest interest="partners" title="Такой формат пригодился бы вашим гостям?" text="На главной можно отметить интерес к Пирогорску и выбрать город. Это анонимная проверка спроса, которая не оформляет партнёрство." label="Отметить интерес" />
  <EditorialLinks title="Для памятки гостю" links={[{ href: '/journal/uzhin-v-semnyh-apartamentah/', title: 'Подготовить кухню к ужину', text: 'Что уточнить о посуде, технике и подаче в незнакомой квартире.', label: 'Практический гид' }, { href: '/delivery/', title: 'Планы доставки', text: 'Какие города рассматриваем и что ещё предстоит подтвердить.', label: 'Перед запуском' }, { href: '/nabor/uzhin-v-apartamentah/', title: 'Ужин в апартаментах', text: 'Как выбираем формат будущей подборки для вечернего стола.', label: 'Сценарий' }]} />
</ContentLayout>
