---
import { Picture } from 'astro:assets';
import ContentLayout from '../layouts/ContentLayout.astro';
import Icon from '../components/Icon.astro';
import { deliveryEstimates } from '../data/pricing';
import { interestHref } from '../data/editorial';
import PieTownHero from '../components/PieTownHero.astro';
import pie from '../../design/pie-city-site-20261030/delivery-town.png';
import kaliningradTown from '../../design/pie-city-site-20261030/kaliningrad-town.png';
import zelenogradskTown from '../../design/pie-city-site-20261030/zelenogradsk-town.png';
import svetlogorskTown from '../../design/pie-city-site-20261030/svetlogorsk-town.png';
import '../styles/delivery.css';
const cities = [
  { image: kaliningradTown, slug: 'kaliningrad', name: 'Калининград', note: 'К ужину дома. К встрече в офисе.', stage: 'Первый этап' },
  { image: zelenogradskTown, slug: 'zelenogradsk', name: 'Зеленоградск', note: 'К общему столу после моря.', stage: 'Первый этап' },
  { image: svetlogorskTown, slug: 'svetlogorsk', name: 'Светлогорск', note: 'К неспешному вечеру на побережье.', stage: 'Следующий этап' },
];
const questions = [
  { title: 'Когда можно будет заказать?', answer: 'Готовим запуск в Калининграде и Зеленоградске. К Светлогорску вернёмся после первых 30 дней работы. Пока можно собрать подборку и отметить интерес. Дату открытия, интервалы, способы оплаты и минимальную сумму опубликуем перед началом продаж.' },
  { title: 'Как считается доставка?', answer: 'Один раз за всю подборку: 350 ₽ в Калининграде, 500 ₽ в Зеленоградске и 650 ₽ в Светлогорске. Это суммы для предварительного расчёта; окончательные тарифы и доступные адреса сообщим перед запуском. При изменении числа пирогов доставка повторно не добавляется.' },
  { title: 'Будет ли самовывоз?', answer: 'Планируем самовывоз без доплаты за получение. Адрес и часы работы опубликуем, когда выберем точку.' },
  { title: 'Все пироги готовы к подаче?', answer: 'В меню есть целые пироги, замороженные продукты и заготовки для выпечки. Формат указан в каждой карточке: выбирайте готовый пирог или выпечку для домашней духовки. Условия хранения, перевозки и подачи уточним до продаж.' },
  { title: 'А за пределы этих городов?', answer: 'Сначала определим границы доставки в трёх городах. Куршскую косу и другие населённые пункты рассматриваем отдельно. На странице города можно отметить интерес — это поможет выбрать направления.' },
];
const title = 'Доставка пирогов в Калининграде, Зеленоградске и Светлогорске | Пирогорск';
const description = 'Доставка пирогов Пирогорска: Калининград — 350 ₽, Зеленоградск — 500 ₽, Светлогорск — 650 ₽ за всю подборку. Меню по городам и условия будущего запуска.';
---
<ContentLayout {title} {description} bodyClass="delivery-page" breadcrumbs={[{ name: 'Доставка', href: '/delivery/' }]}>
  <PieTownHero eyebrow="Пирогорск · доставка пирогов" title="К вашему столу. В вашем городе." intro="Ужин после моря, встреча друзей или обед в офисе. Выбирайте пироги, а доставку считайте один раз — за всю подборку." image={pie} imageAlt="Пироговый город с мостом, синей дорогой и велосипедом для доставки">
    <span slot="title">К вашему столу.<br /><em>В вашем городе.</em></span>
    <Fragment slot="actions"><a class="ed-button" href="#delivery-cities">Выбрать город<Icon name="arrow" /></a><p>Готовим запуск. Сейчас можно собрать подборку и отметить интерес.</p></Fragment>
  </PieTownHero>
  <section class="delivery-cities" id="delivery-cities" aria-labelledby="delivery-cities-heading">
    <header class="delivery-section-heading"><div><p class="delivery-kicker">Ближе, чем кажется</p><h2 id="delivery-cities-heading">Выберите свой город</h2></div><p>Меню, начинки и расчёт<br /> для вашего стола.</p></header>
    <div class="delivery-city-grid">
      {cities.map((city, index) => <a class="delivery-city-card" href={`/${city.slug}/`} data-delivery-city={city.slug}>
        <div class="delivery-city-top"><span class="delivery-city-number">0{index + 1}</span><span class="delivery-city-stage">{city.stage}</span><Icon name="pin" /></div>
        <Picture class="delivery-city-art" src={city.image} formats={['avif', 'webp']} fallbackFormat="webp" widths={[160,240,360,480]} sizes="(max-width: 760px) 100px, 220px" width={240} height={240} quality={55} alt="" loading="lazy" />
        <h3>{city.name}</h3><p>{city.note}</p>
        <div class="delivery-city-bottom"><div><span class="delivery-city-price">{deliveryEstimates[city.name]}<span> ₽</span></span><small>за всю подборку</small></div><span class="delivery-city-arrow"><Icon name="arrow" /></span></div>
      </a>)}
    </div>
    <p class="delivery-price-note">Стоимость для предварительного расчёта. Окончательные тарифы и границы доставки опубликуем перед запуском.</p>
  </section>
  <section class="delivery-principle" aria-labelledby="delivery-principle-heading">
    <div><p class="delivery-kicker">Один стол. Одна доставка.</p><h2 id="delivery-principle-heading">Больше пирогов.<br /><em>Та же доставка.</em></h2></div>
    <div class="delivery-principle-copy"><p>Сытный к ужину, сладкий к чаю, морс и посуда — собирайте всё вместе. Стоимость доставки зависит от города, а не от количества пирогов.</p><a class="delivery-text-link" href="/menu/#nabory">Начать с набора<Icon name="arrow" /></a></div>
  </section>
  <section class="delivery-steps" aria-labelledby="delivery-steps-heading">
    <header class="delivery-section-heading"><div><p class="delivery-kicker">От начинки до общего стола</p><h2 id="delivery-steps-heading">Собрать — просто</h2></div></header>
    <ol>
      <li><span class="delivery-step-number">01</span><h3>Найдите свои вкусы</h3><p>Сытные и сладкие пироги, выпечка и дополнения. Выберите начинку, размер и количество.</p><a class="delivery-text-link" href="/menu/">Выбрать пироги<Icon name="arrow" /></a></li>
      <li><span class="delivery-step-number">02</span><h3>Соберите подборку</h3><p>Добавьте морс и посуду. Город и способ получения помогут рассчитать общую сумму.</p><a class="delivery-text-link" href="/?interest=selection">Открыть подборку<Icon name="arrow" /></a></li>
      <li><span class="delivery-step-number">03</span><h3>Отметьте интерес</h3><p>Расскажите, что выбрали бы. Анонимные ответы помогут подготовить меню и доставку к открытию.</p><a class="delivery-text-link" href={interestHref('delivery')}>Перейти к форме<Icon name="arrow" /></a></li>
    </ol>
  </section>
  <section class="delivery-faq" aria-labelledby="delivery-faq-heading">
    <div><p class="delivery-kicker">Всё по делу</p><h2 id="delivery-faq-heading">Хорошие<br /> вопросы</h2><p class="delivery-faq-intro">Про запуск, получение<br /> и пироги к вашему столу.</p></div>
    <div class="delivery-faq-list">{questions.map(question => <details><summary>{question.title}<span class="delivery-faq-plus" aria-hidden="true"><Icon name="plus" /></span></summary><p>{question.answer}</p></details>)}</div>
  </section>
  <aside class="delivery-finale" aria-labelledby="delivery-finale-heading"><Icon name="wave" /><p class="delivery-kicker">У самого Балтийского моря</p><h2 id="delivery-finale-heading">У хорошего вечера<br />есть свой пирог.</h2><a class="delivery-button" href="/menu/">Найти свой<Icon name="arrow" /></a></aside>
</ContentLayout>
