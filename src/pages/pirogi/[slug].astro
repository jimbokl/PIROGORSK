---
import { getImage } from 'astro:assets';
import ProductVisual from '../../components/ProductVisual.astro';
import ProductAddOns from '../../components/ProductAddOns.astro';
import ProductOptions from '../../components/ProductOptions.astro';
import ProductRecommendations from '../../components/ProductRecommendations.astro';
import ContentLayout from '../../layouts/ContentLayout.astro';
import ProductHero from '../../components/ProductHero.astro';
import EditorialBody from '../../components/EditorialBody.astro';
import EditorialInterest from '../../components/EditorialInterest.astro';
import EditorialLinks from '../../components/EditorialLinks.astro';
import FillingRatioBar from '../../components/FillingRatioBar.astro';
import { editorialProducts, productHref, siteOrigin, scenarios } from '../../data/editorial';
export function getStaticPaths() {
  return editorialProducts.map(product => ({ params: { slug: product.editorial.slug }, props: { product } }));
}
interface Props { product: (typeof editorialProducts)[number] }
const { product } = Astro.props;
const title = `${product.name} — 500 г и 1 кг | Пирогорск`;
const description = `${product.name}. ${product.description}`;
const image = product.image ? await getImage({ src: product.image, width: 1000, format: 'webp', quality: 65 }) : undefined;
const schema = [{ '@type': 'Product', '@id': `${siteOrigin}${productHref(product)}#product`, name: product.name, description: product.editorial.intro, url: `${siteOrigin}${productHref(product)}`, ...(image ? { image: new URL(image.src, siteOrigin).href } : {}), brand: { '@type': 'Brand', name: 'Пирогорск' }, category: 'Концепт будущего меню' }];
const otherProducts = editorialProducts.filter(other => other.id !== product.id && other.sweet === product.sweet).slice(0, 2);
const scenario = scenarios.find(item => item.slug === product.editorial.scenario)!;
---
<ContentLayout {title} {description} breadcrumbs={[{ name: 'Меню', href: '/menu/' }, { name: product.name, href: productHref(product) }]} {schema}>
  <ProductHero productId={product.id} eyebrow={`${product.sweet ? 'Сладкий' : 'Сытный'} пирог · будущее меню`} title={product.name} intro={product.editorial.intro}><ProductVisual slot="visual" {product} layout="hero" /><ProductOptions slot="actions" {product} showDelivery /></ProductHero>
  <ProductAddOns {product} />
  <EditorialBody sections={[
    { title: 'О начинке', paragraphs: [product.editorial.question] },
    { title: 'С чем поставить на стол', paragraphs: [product.editorial.pairing] },
    { title: 'К запуску меню', paragraphs: ['Перед началом продаж опубликуем полный состав и аллергены, условия хранения и рекомендации по разогреву. Сейчас рецепты и цены предварительные, а изображения показывают идею будущих пирогов.'] },
  ]} />
  <EditorialInterest interest={product.id} title={`Интересен ${product.name.toLowerCase()}?`} label="Отметить интерес к пирогу" />
  {!product.sweet && <FillingRatioBar/>}
  <EditorialLinks title="Вес и количество для вашего стола" links={[{href:'/journal/skolko-piroga-na-cheloveka/',title:'Сколько пирога на компанию',text:'Таблица веса и калькулятор для разных порций.',label:'Расчёт'},{href:'/journal/pirog-500-g-ili-1-kg/',title:'500 г или 1 кг',text:'Сравнение одинакового веса и разных вкусов.',label:'Форматы'}]}/>
  <ProductRecommendations products={otherProducts} />
  <EditorialLinks title="Продумать общий стол" links={[{ href: `/nabor/${scenario.slug}/`, title: scenario.title, text: scenario.description, label: 'Сценарий' }]} />
</ContentLayout>
