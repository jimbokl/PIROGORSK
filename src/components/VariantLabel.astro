---
interface Props { label: string; price: number; from?: boolean }
const { label, price, from = false } = Astro.props;
---
<span class="variant-summary" data-variant-price={price}><b>{label}</b><small>{from ? 'от ' : ''}{price.toLocaleString('ru-RU')} ₽</small></span>
<style>
  .variant-summary{display:flex;flex-direction:column;gap:3px}
  b{font:inherit;font-weight:500}
  small{display:block;margin:0;color:inherit;font:400 10px/1.3 var(--sans);font-variant-numeric:tabular-nums;white-space:nowrap}
</style>
