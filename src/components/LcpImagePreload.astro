---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  src: ImageMetadata;
  widths: number[];
  sizes: string;
  width: number;
  height: number;
  quality: number;
}
const { sizes, ...options } = Astro.props;
// Match Picture's first source so the preload and visible image share one request.
const image = await getImage({ ...options, format: 'avif' });
---
<link rel="preload" as="image" type="image/avif" href={image.src} imagesrcset={image.srcSet.attribute} imagesizes={sizes} fetchpriority="high" />
