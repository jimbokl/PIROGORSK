---
import { catalog } from '../data/catalog';
import { addOnGroups } from '../data/bundles';
import type { Product } from '../data/catalog';
import ProductVisual from './ProductVisual.astro';
import { hasPortionPrice } from '../lib/product-portions';
interface Props { mode?: 'selection' | 'product'; product?: Product }
const { mode = 'selection', product } = Astro.props;
const detail = mode === 'product';
const headingId = detail ? 'product-addons-heading' : 'addons-heading';
const Heading = detail ? 'h2' : 'h3';
const CardHeading = detail ? 'h3' : 'h4';
const groups = addOnGroups.filter(group => group.id !== 'picnic' || !product || hasPortionPrice(product)).map(group => ({ ...group, choices: group.choices.filter(choice => choice.id !== product?.id) })).filter(group => group.choices.length);
const money = (value: number) => `${value.toLocaleString('ru-RU')} ₽`;
---
<section class:list={['selection-addons', { 'product-addons': detail }]} data-upsells={!detail || undefined} data-product-addons={detail || undefined} hidden={!detail} aria-labelledby={headingId}>
  <Heading id={headingId} class="addons-heading" tabindex="-1">{detail ? 'С этим берут' : 'К пирогам на стол'}</Heading>
  <p>{detail ? 'К чаю, к общему столу или на прогулку. Добавьте то, что пригодится к вашим пирогам.' : 'Добавьте по желанию — всё можно изменить.'}</p>
  <div class="addons-grid">
  {groups.map(group => {
    const first = group.choices[0];
    const firstPrice = catalog.find(product => product.id === first.id)!.prices[first.value] * first.quantity;
    return <article class="addon-card" data-upsell-group={group.id}>
    <div class="addon-art" aria-hidden="true"><ProductVisual product={catalog.find(product => product.id === (group.id === 'sweet' ? first.id : group.imageId))!} decorative thumbnail /></div>
    <div class="addon-body">
      <CardHeading class="addon-title">{group.id === 'picnic' ? <a href="/catalog/baltiyskiy-piknik-set/">{group.title}</a> : group.title}</CardHeading><p>{group.description}</p>
      <label for={`${mode}-addon-${group.id}`} class="addon-label">{group.id === 'picnic' ? 'Сколько сетов' : group.id === 'tableware' ? 'На сколько гостей' : group.id === 'sweet' ? 'Начинка · 500 г' : 'Вкус и объём'}</label>
      <div class="addon-controls">
        <select id={`${mode}-addon-${group.id}`} data-upsell-choice={group.id}>
          {group.choices.map(choice => {
            const product = catalog.find(product => product.id === choice.id)!;
            const variant = product.variants.find(variant => variant.value === choice.value)!;
            const shortName: Record<string, string> = { cranberry: 'Клюква', seabuckthorn: 'Облепиха', apple: 'Яблоко и брусника', cherry: 'Вишня', curd: 'Творог и малина' };
            const label = group.id === 'picnic' ? `${choice.quantity} ${choice.quantity === 1 ? 'сет' : 'сета'} · на ${choice.quantity * 2} человек` : group.id === 'tableware' ? `${choice.quantity} ${choice.quantity === 1 ? 'набор' : 'наборов'}` : group.id === 'sweet' ? shortName[choice.id] : `${shortName[choice.id]} · ${variant.label}`;
            return <option value={`${choice.id}:${choice.value}:${choice.quantity}`} data-price={variant.price * choice.quantity}>{label}</option>;
          })}
        </select>
        <button type="button" class:list={['addon-add', detail ? 'ed-button' : 'button']} data-upsell-add={group.id} aria-label={`Добавить за ${money(firstPrice)}: ${group.title}`}>Добавить за {money(firstPrice)}</button>
      </div>
      {detail && <p class="addon-saved" data-addon-saved={group.id}></p>}
    </div>
  </article>})}
  </div>
  {detail && <div class="addons-footer"><div><p>Цены предварительные. Доставка одна на всю подборку.</p><p class="addons-feedback" role="status" aria-live="polite" aria-atomic="true" data-addon-feedback></p></div><a class="ed-button" href="/?interest=selection" data-addon-selection data-open="selection-dialog">Открыть подборку</a></div>}
</section>
<style>
  .selection-addons{padding-block:22px;border-bottom:1px solid var(--line)}
  .selection-addons .addons-heading{font:500 25px/1.2 var(--serif);letter-spacing:-.025em;margin:0}
  .selection-addons>p{font-size:12px;color:var(--muted);margin:8px 0 16px;line-height:1.6}
  .addon-card{display:grid;grid-template-columns:76px minmax(0,1fr);gap:12px;padding:16px 0;border-top:1px solid var(--line)}
  .addon-card[hidden]{display:none}
  .addon-art{align-self:start;border-radius:var(--radius-control);overflow:hidden;background:var(--paper-raised)}
  .addon-art :global(.product-visual-badge){display:none}
  .addon-art :global(.product-visual){width:100%;height:auto;aspect-ratio:1;margin:0!important}
  .addon-body{min-width:0}.addon-body .addon-title{font:500 18px/1.3 var(--serif);margin:0}
  .addon-title a{color:inherit;text-decoration-color:var(--copper,#a76525);text-underline-offset:4px}
  .addon-body p{font:400 12px/1.6 var(--sans);color:var(--muted);margin:5px 0 10px}
  .addon-label{display:block;font-size:11px;margin-bottom:5px;color:var(--muted)}
  .addon-controls{display:grid;gap:8px;grid-template-columns:minmax(0,1fr) auto;align-items:center}
  .addon-controls select{min-width:0;width:100%;min-height:var(--control-height);padding:10px 24px 10px 10px;border:1px solid var(--line);border-radius:var(--radius-control);background:var(--paper);color:var(--navy);font:400 var(--input-font-size)/1.5 var(--sans)}
  .addon-controls .addon-add{padding:10px 14px;min-height:var(--control-height);font-size:12px}
  .addon-controls :is(select,button):focus-visible{outline:3px solid var(--focus);outline-offset:3px}
  @media(max-width:600px){.addon-card{grid-template-columns:56px minmax(0,1fr);gap:10px}.addon-controls{grid-template-columns:minmax(0,1fr)}.addon-add{width:100%}.addon-body .addon-title{font-size:18px}}
  .product-addons{padding-block:32px;margin-bottom:40px;border-block:1px solid var(--line)}
  .product-addons .addons-heading{font-size:clamp(29px,3vw,38px)}
  .product-addons>p{font-size:14px;max-width:64ch;margin-bottom:24px}
  .product-addons .addons-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
  .product-addons .addon-card{grid-template-columns:96px minmax(0,1fr);grid-template-rows:auto 1fr auto auto 20px;gap:10px 18px;padding:22px;border:1px solid var(--brand-line);border-radius:24px;background:linear-gradient(135deg,#fffdf9,#fff 75%)}
  .product-addons .addon-art{grid-column:1;grid-row:1/4;width:100%;border-radius:18px;background:var(--brand-paper)}
  .product-addons .addon-body{display:contents}
  .product-addons .addon-title{grid-column:2;grid-row:1;min-height:0;font-size:24px;line-height:1.2}
  .product-addons .addon-body>p:not(.addon-saved){grid-column:2;grid-row:2;min-height:0;margin:0;font-size:13px;line-height:1.65}
  .product-addons .addon-label{grid-column:2;grid-row:3;margin:0}
  .product-addons .addon-controls{grid-column:1/-1;grid-row:4;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:10px;margin:4px 0 0}
  .product-addons .addon-controls select{background:#fffdf9;border-color:#dfd6c8;padding-left:14px}
  .product-addons .addon-add{width:100%;border:0;font-family:var(--sans);cursor:pointer;justify-content:center}
  .product-addons .addon-saved{grid-column:1/-1;grid-row:5;min-height:20px;margin:0;font-size:11px}
  .addons-footer{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-top:22px}
  .addons-footer p{font-size:12px;line-height:1.6;color:var(--muted)}
  .addons-feedback{min-height:22px;margin-top:6px}
  .addons-footer>a{flex-shrink:0}
  @media(max-width:1000px){.product-addons .addon-card{grid-template-columns:80px minmax(0,1fr);padding:18px;gap:10px 14px}.product-addons .addon-title{font-size:22px}.product-addons .addon-controls{grid-template-columns:minmax(0,1fr)}}
  @media(max-width:700px){.product-addons .addons-grid{grid-template-columns:1fr;gap:14px}.product-addons .addon-card{grid-template-columns:88px minmax(0,1fr)}.addons-footer{align-items:stretch;flex-direction:column;gap:10px}.addons-footer>a{width:100%}}
  @media(max-width:360px){.product-addons .addon-card{grid-template-columns:72px minmax(0,1fr);padding:16px;gap:10px 12px}.product-addons .addon-title{font-size:20px}}
</style>
