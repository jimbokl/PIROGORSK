---
import { catalog, products, extras } from '../data/catalog';
import { supplierProducts } from '../data/holland-catalog';
import { freshProducts } from '../data/pirogi39-catalog';
import ProductVisual from './ProductVisual.astro';
import SupplierArtwork from './SupplierArtwork.astro';
import Icon from './Icon.astro';

const first = (items: typeof catalog, predicate: (item: typeof catalog[number]) => boolean) => items.find(predicate);
const departments = [
  { title: 'Целые пироги', note: '61 начинка · «Пироги а-ля Русс»', href: '/menu/#pirogi39', product: freshProducts[0], supplier: true, tone: 'sea' },
  { title: 'Мини-пироги', note: 'Небольшие форматы к столу', href: '/menu/?group=mini-pies#holland', product: first(supplierProducts, p => p.category === 'mini-pies'), supplier: true, tone: 'berry' },
  { title: 'Сладкое к чаю', note: 'Десерты и торты', href: '/menu/?group=desserts#holland', product: first(supplierProducts, p => p.category === 'desserts'), supplier: true, tone: 'cream' },
  { title: 'Хлеб и булочки', note: 'Выпечка Holland Bakery', href: '/menu/?group=bread#holland', product: first(supplierProducts, p => p.category === 'bread'), supplier: true, tone: 'wheat' },
  { title: 'Для домашней выпечки', note: 'Замороженные заготовки', href: '/menu/?group=bake#holland', product: first(supplierProducts, p => p.category === 'bake' || p.category === 'dough'), supplier: true, tone: 'blue' },
  { title: 'Наши первые идеи', note: '8 начинок Пирогорска', href: '/menu/#pirogi', product: products[0], supplier: false, tone: 'navy' },
  { title: 'Напитки и посуда', note: 'Дополнения к общему столу', href: '/menu/#menu-extras-title', product: extras[0], supplier: false, tone: 'berry' },
].filter(item => item.product);
const count = catalog.length;
const countLabel = new Intl.PluralRules('ru').select(count) === 'one' ? 'позиция' : new Intl.PluralRules('ru').select(count) === 'few' ? 'позиции' : 'позиций';
---

<section class="home-departments container" aria-labelledby="departments-heading">
  <div class="departments-heading">
    <div><p class="eyebrow">Выбирайте по настроению</p><h2 id="departments-heading">Меню по разделам</h2></div>
    <a class="departments-all" href="/menu/">Всё меню · {count} {countLabel} <Icon name="arrow" /></a>
  </div>
  <nav class="departments-grid" aria-label="Основные разделы меню">
    {departments.slice(0, 4).map(item => <a class:list={['department-card', `department-card--${item.tone}`]} href={item.href}>
      <span class="department-art" aria-hidden="true">{item.supplier ? <SupplierArtwork id={item.product!.id} sizes="(max-width: 650px) 170px, 280px" decorative /> : <ProductVisual product={item.product!} decorative />}</span>
      <span class="department-copy"><strong>{item.title}</strong><small>{item.note}</small></span><span class="department-arrow" aria-hidden="true"><Icon name="arrow" /></span>
    </a>)}
  </nav>
  <nav class="departments-more" aria-label="Ещё в меню">{departments.slice(4).map(item => <a href={item.href}>{item.title}<Icon name="arrow" /></a>)}<a href="/podbor/">Сколько пирогов взять?<Icon name="arrow" /></a></nav>
</section>

<style>
.home-departments{margin:60px auto}
.departments-heading{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:26px}
.departments-heading .eyebrow{margin:0 0 10px;color:var(--muted);font-size:11px;letter-spacing:.1em;text-transform:uppercase}
.departments-heading h2{margin:0;font:500 var(--heading-section)/1.15 var(--serif);letter-spacing:-.03em}
.departments-all{display:inline-flex;align-items:center;gap:10px;min-height:48px;font-size:13px;font-weight:500;text-decoration:none}
.departments-all :global(svg){width:17px;height:17px}
.departments-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}
.department-card{position:relative;display:block;min-width:0;overflow:hidden;border:1px solid var(--line);border-radius:var(--radius-card);background:var(--soft);color:var(--ink);text-decoration:none;transition:transform .25s var(--ease-out),background .25s}
.department-card--sea,.department-card--berry{background:var(--soft)}
.department-art{display:block;height:184px;padding:10px 24px 0}
.department-art :global(:is(.product-artwork,.product-visual)){height:100%;width:100%;aspect-ratio:auto;background:transparent;isolation:auto;overflow:visible}
.department-art :global(.product-backdrop),.department-art :global(.product-visual-background),.department-art :global(.product-visual-badge){display:none}
.department-art :global(.product-artwork-subject){inset:0;mask-image:none;mix-blend-mode:darken}
.department-copy{display:flex;flex-direction:column;gap:7px;padding:8px 44px 24px 22px}
.department-copy strong{font:500 19px/1.25 var(--sans);letter-spacing:-.035em}
.department-copy small{color:var(--muted);font-size:11px;line-height:1.5}
.department-arrow{position:absolute;right:16px;bottom:23px;display:grid;place-items:center;width:28px;height:28px}
.department-arrow :global(svg){width:18px;height:18px}
.departments-more{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0 24px;margin-top:20px;border-bottom:1px solid var(--line);padding-bottom:12px}
.departments-more a{display:inline-flex;align-items:center;gap:10px;min-height:48px;font-size:13px;text-decoration:none}.departments-more :global(svg){width:15px;height:15px}
.department-card:focus-visible,.departments-more a:focus-visible,.departments-all:focus-visible{outline:3px solid var(--focus);outline-offset:4px}
@media(hover:hover){.department-card:hover{transform:translateY(-3px)}.departments-more a:hover,.departments-all:hover{text-decoration:underline;text-underline-offset:5px}}
@media(max-width:1000px){.department-art{height:150px;padding-inline:12px}.department-copy{padding:8px 34px 20px 16px}.department-copy strong{font-size:17px}.department-copy small{font-size:10px}}
@media(max-width:650px){.home-departments{margin-block:42px}.departments-heading{align-items:center;gap:14px;margin-bottom:20px}.departments-heading .eyebrow{display:none}.departments-all{font-size:11px;max-width:116px;line-height:1.5}.departments-grid{grid-template-columns:none;grid-auto-flow:column;grid-auto-columns:168px;gap:12px;overflow-x:auto;scroll-snap-type:x proximity;padding:3px 3px 12px;margin-inline:-3px}.department-card{scroll-snap-align:start;border-radius:20px}.department-art{height:136px;padding:8px 8px 0}.department-copy{padding:10px 28px 18px 14px;gap:5px;min-height:82px}.department-copy strong{font-size:16px}.department-copy small{font-size:10px}.department-arrow{right:8px;bottom:19px;width:20px}.departments-more{justify-content:flex-start;gap:0 18px;margin-top:8px;padding-bottom:10px}.departments-more a{font-size:12px}.departments-more :global(svg){display:none}}
@media(prefers-reduced-motion:reduce){.department-card{transition:none}.department-card:hover{transform:none}}
</style>
