---
import { catalog, products, extras } from '../data/catalog';
import { supplierProducts } from '../data/holland-catalog';
import { freshProducts } from '../data/pirogi39-catalog';
import ProductVisual from './ProductVisual.astro';
import SupplierArtwork from './SupplierArtwork.astro';
import Icon from './Icon.astro';

const first = (items: typeof catalog, predicate: (item: typeof catalog[number]) => boolean) => items.find(predicate);
const departments = [
  { title: 'Целые пироги', note: '61 начинка · «Пироги а-ля Русс»', href: '/menu/#pirogi39', product: freshProducts[0], supplier: true, tone: 'sea' },
  { title: 'Мини-пироги', note: 'Небольшие форматы к столу', href: '/menu/?group=mini-pies#holland', product: first(supplierProducts, p => p.category === 'mini-pies'), supplier: true, tone: 'berry' },
  { title: 'Сладкое к чаю', note: 'Десерты и торты', href: '/menu/?group=desserts#holland', product: first(supplierProducts, p => p.category === 'desserts'), supplier: true, tone: 'cream' },
  { title: 'Хлеб и булочки', note: 'Выпечка Holland Bakery', href: '/menu/?group=bread#holland', product: first(supplierProducts, p => p.category === 'bread'), supplier: true, tone: 'wheat' },
  { title: 'Для домашней выпечки', note: 'Замороженные заготовки', href: '/menu/?group=bake#holland', product: first(supplierProducts, p => p.category === 'bake' || p.category === 'dough'), supplier: true, tone: 'blue' },
  { title: 'Наши первые идеи', note: '8 начинок Пирогорска', href: '/menu/#pirogi', product: products[0], supplier: false, tone: 'navy' },
  { title: 'Напитки и посуда', note: 'Дополнения к общему столу', href: '/menu/#menu-extras-title', product: extras[0], supplier: false, tone: 'berry' },
].filter(item => item.product);
const count = catalog.length;
const countLabel = new Intl.PluralRules('ru').select(count) === 'one' ? 'позиция' : new Intl.PluralRules('ru').select(count) === 'few' ? 'позиции' : 'позиций';
---

<section class="home-departments container" aria-labelledby="departments-heading">
  <div class="departments-heading">
    <div><p class="eyebrow">Выбирайте по настроению</p><h2 id="departments-heading">Меню по разделам</h2></div>
    <a class="departments-all" href="/menu/">Всё меню · {count} {countLabel} <Icon name="arrow" /></a>
  </div>
  <nav class="departments-grid" aria-label="Разделы меню">
    {departments.map((item, index) => <a class:list={['department-card', `department-card--${item.tone}`]} href={item.href}>
      <span class="department-art" aria-hidden="true">
        {item.supplier ? <SupplierArtwork id={item.product!.id} decorative /> : <ProductVisual product={item.product!} decorative />}
      </span>
      <span class="department-copy"><span class="department-index">{String(index + 1).padStart(2, '0')}</span><strong>{item.title}</strong><small>{item.note}</small></span>
      <span class="department-arrow" aria-hidden="true"><Icon name="arrow" /></span>
    </a>)}
  </nav>
</section>

<style>
  .home-departments { margin: clamp(42px, 6vw, 78px) auto; }
  .departments-heading { display:flex; align-items:end; justify-content:space-between; gap:24px; margin-bottom:22px; }
  .departments-heading .eyebrow { margin:0 0 8px; color:var(--muted); font-size:12px; letter-spacing:.09em; text-transform:uppercase; }
  .departments-heading h2 { margin:0; color:var(--ink); font-family:var(--display, 'Playfair Display', Georgia, serif); font-size:clamp(30px,4vw,48px); font-weight:600; line-height:1.08; letter-spacing:-.035em; }
  .departments-all { display:inline-flex; align-items:center; gap:8px; min-height:44px; color:var(--ink); font-size:14px; font-weight:600; text-decoration:none; text-underline-offset:4px; }
  .departments-all:hover { text-decoration:underline; }
  .departments-all :global(svg) { width:17px; height:17px; }
  .departments-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:14px; }
  .department-card { min-width:0; min-height:220px; position:relative; display:flex; flex-direction:column; justify-content:space-between; overflow:hidden; padding:10px 13px 14px; border:1px solid color-mix(in srgb,var(--ink) 10%,transparent); border-radius:8px; color:var(--ink); background:var(--paper,#fbf9f4); text-decoration:none; transition:transform .28s cubic-bezier(.16,1,.3,1),box-shadow .28s ease,border-color .28s ease; }
  .department-card:hover,.department-card:focus-visible { transform:translateY(-3px); border-color:color-mix(in srgb,var(--ink) 28%,transparent); box-shadow:0 12px 28px rgb(8 47 60 / 10%); }
  .department-card:focus-visible { outline:3px solid var(--focus); outline-offset:3px; }
  .department-art { position:absolute; inset:0 0 66px; display:block; overflow:hidden; }
  .department-art :global(.product-visual),.department-art :global(.product-artwork) { width:100%; height:100%; aspect-ratio:auto; border-radius:0; background:transparent; }
  .department-art :global(.product-visual-background),.department-art :global(.product-visual-legacy),.department-art :global(.product-artwork picture img),.department-art :global(.product-backdrop) { object-fit:cover; }
  .department-art :global(.product-visual-subject) { width:min(72%,230px); }
  .department-art :global(.product-artwork-subject) { position:absolute; inset:0; display:block; }
  .department-art :global(.product-artwork-subject img) { width:100%; height:100%; object-fit:contain; }
  .department-copy { z-index:1; display:grid; grid-template-columns:auto 1fr; align-items:baseline; gap:3px 8px; padding:8px 24px 0 0; margin-top:auto; background:linear-gradient(180deg,transparent 0%,var(--paper,#fbf9f4) 19%); }
  .department-index { grid-row:1 / span 2; align-self:center; color:var(--muted); font-size:10px; font-variant-numeric:tabular-nums; }
  .department-copy strong { font-size:16px; line-height:1.2; letter-spacing:-.02em; }
  .department-copy small { color:var(--muted); font-size:11px; line-height:1.35; }
  .department-arrow { position:absolute; z-index:2; right:11px; bottom:13px; display:grid; place-items:center; width:29px; height:29px; border:1px solid color-mix(in srgb,var(--ink) 15%,transparent); border-radius:50%; background:var(--paper,#fbf9f4); }
  .department-arrow :global(svg) { width:15px; height:15px; }
  .department-card--sea { background:#e2eeeb; } .department-card--berry { background:#f2e5df; } .department-card--cream { background:#f3ead6; } .department-card--wheat { background:#eee6d7; } .department-card--blue { background:#e3eaec; } .department-card--navy { background:#e6ece9; }
  @media (min-width:1050px) { .department-card { min-height:238px; padding-inline:16px; } .department-copy strong { font-size:18px; } .department-copy small { font-size:12px; } }
  @media (max-width:760px) { .home-departments { margin:42px auto; } .departments-grid { grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; } .department-card { min-height:190px; padding:8px 10px 12px; } .department-art { bottom:60px; } .department-copy strong { font-size:14px; } .department-copy small { font-size:10px; } .department-arrow { right:8px; bottom:10px; width:26px; height:26px; } }
  @media (max-width:420px) { .departments-heading { align-items:start; flex-direction:column; gap:10px; } .departments-heading h2 { font-size:32px; } .department-card { min-height:174px; } .department-art { bottom:58px; } .department-copy { grid-template-columns:auto 1fr; } .department-copy strong { font-size:13px; } }
  @media (prefers-reduced-motion:reduce) { .department-card { transition:none; } .department-card:hover,.department-card:focus-visible { transform:none; } }

  .departments-grid { grid-template-columns:repeat(7,minmax(0,1fr)); gap:10px; }
  .department-card { min-height:186px; padding:8px 10px 12px; }
  .department-copy { display:block; padding:8px 16px 0 0; }
  .department-index,.department-copy small { display:none; }
  .department-copy strong { font-size:14px; }
  .department-art { bottom:48px; }
  .department-arrow { width:22px; height:22px; right:6px; bottom:10px; }
  @media(max-width:1050px) {
    .departments-grid { display:flex; overflow-x:auto; gap:10px; padding:3px 2px 14px; scroll-snap-type:x proximity; }
    .department-card { flex:0 0 150px; min-height:170px; scroll-snap-align:start; }
  }
  @media(max-width:420px) {
    .departments-heading { gap:4px; }
    .department-card { flex-basis:138px; min-height:160px; }
    .department-copy strong { font-size:14px; }
  }
</style>
