---
import { productFillings } from '../lib/catalog-fillings';
import Icon from './Icon.astro';
import MenuQuantity from './MenuQuantity.astro';
import PiePortions from './PiePortions.astro';
import SupplierArtwork from './SupplierArtwork.astro';
import { catalogProductHref } from '../lib/product-paths';
import { freshProducts, freshGroups } from '../data/pirogi39-catalog';
import { supplierProducts as hollandProducts, supplierGroups as hollandGroups } from '../data/holland-catalog';
import '../styles/supplier-catalog.css';
interface Props { interactive?: boolean; fresh?: boolean; feed?: boolean }
const { interactive = true, fresh = false, feed = false } = Astro.props;
const supplierProducts = fresh ? freshProducts : hollandProducts;
const supplierGroups = fresh ? freshGroups : hollandGroups;
const sectionId = fresh ? 'pirogi39' : 'holland';
const producer = fresh ? 'Пироги а-ля Русс' : 'Holland Bakery';
const sourceUrl = fresh ? 'https://pirogi39.ru/' : 'https://hollandbakery.ru/';
const money = (value: number) => `${value.toLocaleString('ru-RU')} ₽`;
---
<section id={sectionId} class="supplier-catalog" aria-labelledby={`${sectionId}-heading`} data-supplier-catalog data-menu-section data-menu-feed={feed || undefined}>
  <header class="supplier-heading"><div><p class="eyebrow">{fresh ? 'Целые пироги' : 'Выпечка и заготовки'} · позиций: {supplierProducts.length}</p><h2 id={`${sectionId}-heading`}>{fresh ? 'Пироги а-ля Русс' : 'Из Голландской пекарни'}</h2></div><a href={sourceUrl} target="_blank" rel="noopener" aria-label={`О производителе: ${producer}`}>О пекарне ↗</a></header>
  <details class="supplier-info"><summary>Об ассортименте и форматах</summary><p class="supplier-intro">{fresh ? '61 целый пирог из каталога pirogi39.ru: от ржаных и лоранских до сибирских, прусских и осетинских. Выбирайте начинки и размеры, которые хотели бы видеть у Пирогорска.' : 'Добавляем к нашим идеям ассортимент Holland Bakery: мини-пироги, хлеб, десерты и выпечку. Выберите то, что хотели бы получать через Пирогорск.'}</p><div class="supplier-note"><strong>Пока изучаем спрос.</strong> {fresh ? 'Здесь готовые целые пироги в весах производителя. Можно сравнить их с нашими первыми идеями и мини-пирогами ниже.' : 'Здесь замороженные продукты и заготовки для домашней выпечки. Небольшие наборы — планируемый формат Пирогорска из заводских упаковок.'} Наличие, фасовку, состав и условия хранения подтвердим до начала продаж. Цены предварительные, доставка считается отдельно за всю подборку.</div></details>
  <div class="supplier-tools"><label class="supplier-search" hidden={feed}>Найти в ассортименте<input type="search" data-supplier-search placeholder={fresh ? 'Например, курник или палтус' : 'Например, вишня или круассан'} autocomplete="off" /></label><p class="supplier-count" data-supplier-count role="status" aria-live="polite">{supplierProducts.length} позиций</p></div>
  <div class="supplier-filters" role="group" aria-label="Раздел ассортимента">{supplierGroups.map(([id, label]) => <button type="button" data-supplier-filter={id} aria-pressed={id === 'all'}>{label} <span>{id === 'all' ? supplierProducts.length : supplierProducts.filter(p => p.category === id).length}</span></button>)}</div>
  <div class="supplier-grid">{supplierProducts.map((product, index) => {
    const selected = product.variants.find(v => v.value === product.defaultVariant)!;
    const groupLabel = supplierGroups.find(([id]) => id === product.category)![1];
    return <article id={product.id} class="supplier-card" data-supplier-id={product.id} data-fillings={productFillings(product).join(" ")} data-supplier-group={product.category} data-supplier-name={product.name.toLocaleLowerCase('ru-RU')} data-supplier-search={[product.name, product.description, groupLabel, producer, ...product.variants.map(v => v.label)].join(' ')} data-product={interactive ? product.id : undefined} data-kind={interactive ? product.kind : undefined} aria-labelledby={`name-${product.id}`}>
      <div class="supplier-card-top"><span>{groupLabel}</span><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span></div>
      <a class="supplier-art-link" href={catalogProductHref(product)} aria-label={`Подробнее: ${product.name}`}><SupplierArtwork id={product.id} decorative sizes={feed ? '(max-width: 600px) max(114px, calc(34vw - 12px)), (max-width: 1000px) 176px, 220px' : undefined} /></a>
      <h3 id={`name-${product.id}`}><a href={catalogProductHref(product)}>{product.name}</a></h3><p class="supplier-format">{product.description}<PiePortions {product} /></p>
      <fieldset class="supplier-variants"><legend class="sr-only">Формат: {product.name}</legend>{product.variants.map(variant => <label><input type="radio" name={`format-${product.id}`} value={variant.value} data-supplier-unit-price={variant.price} checked={variant.value === product.defaultVariant} /><span>{variant.label}</span></label>)}</fieldset>
      <div class="supplier-card-bottom">{feed && <MenuQuantity name={product.name} />}<div class="supplier-purchase"><div>{product.supplier!.priceFrom && <span class="supplier-from">от </span>}<strong data-price={interactive ? '' : undefined} data-supplier-price>{money(selected.price)}</strong><small data-feed-price-note={feed ? '' : undefined}>Предварительно</small></div>{interactive ? <button type="button" class="button button-small" data-add={product.id} aria-label={`В подборку: ${product.name}`}><span>В подборку</span><Icon name="check" class="added-icon" /></button> : <a class="button button-small" data-supplier-link href={`/?interest=${product.id}&variant=${selected.value}#${sectionId}`}>В подборку<Icon name="arrow" /></a>}</div></div>
    </article>;
  })}</div>
  <p class="supplier-empty" data-supplier-empty hidden>Такой позиции пока нет. Попробуйте другое название или раздел.</p>
  <button type="button" class="button button-secondary supplier-more" data-supplier-more hidden>Показать ещё</button>
  <p class="supplier-footnote">Ассортимент и заводские форматы — по <a href={sourceUrl} target="_blank" rel="noopener">публичному каталогу {producer}</a>, проверенному 29 октября 2026. Розничные цены и наборы рассчитывает Пирогорск. Это не подтверждение поставок или партнёрства.</p>
</section>
<script>import '../scripts/supplier-catalog';</script>
