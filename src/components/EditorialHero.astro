---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { conceptCaption } from '../data/editorial';
interface Props { eyebrow: string; title: string; intro: string; image?: ImageMetadata; imageAlt?: string; compact?: boolean }
const { eyebrow, title, intro, image, imageAlt = '', compact = false } = Astro.props;
const hasVisual = Boolean(image) || Astro.slots.has('visual');
---
<section class:list={['ed-hero', { 'ed-hero-compact': compact, 'ed-hero-text': !hasVisual }]}>
  <div class="ed-hero-copy"><p class="ed-eyebrow">{eyebrow}</p><h1>{title}</h1><p class="ed-intro">{intro}</p><slot /></div>
  {hasVisual && <figure class="ed-hero-art">{image ? <Picture src={image} formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(max-width: 760px) 92vw, 52vw" width={800} height={Math.round(800 * image.height / image.width)} quality={58} alt={imageAlt} loading="eager" decoding="async" fetchpriority="high" /> : <slot name="visual" />}<figcaption>{conceptCaption}</figcaption></figure>}
</section>
