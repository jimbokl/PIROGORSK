---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import fish from '../../design/layered-assets-v2/hero/pie.png';
import cherry from '../../design/layered-assets-v2/cherry/pie.png';
import coast from '../../design/layered-assets-v2/hero/background.png';
import bundle from '../../design/assets-source/bundle.png';
import '../styles/tasting-hero.css';
const slides = [
  { id: 'pies', eyebrow: 'ПИРОГИ К ВАШЕМУ СТОЛУ', title: 'Рыбный пирог', note: 'Выберите начинку и размер в меню.', href: '/menu/', cta: 'Смотреть меню', image: fish, alt: 'Визуальный концепт рыбного пирога с кусочком и начинкой' },
  { id: 'company', eyebrow: 'КОГДА СОБИРАЕТСЯ КОМПАНИЯ', title: 'Соберите общий стол', note: 'Несколько пирогов с разными начинками.', href: '#nabory', cta: 'Подобрать набор', image: bundle, alt: 'Пироги для общего стола, визуальный концепт' },
  { id: 'tea', eyebrow: 'К ЧАЮ И МОРСКОЙ ПРОГУЛКЕ', title: 'Ягодный пирог', note: 'Вишнёвый вкус среди первых идей меню.', href: '/menu/', cta: 'Выбрать пироги', image: cherry, alt: 'Визуальный концепт пирога с вишней' },
];
---
<section class="tasting-hero container" aria-labelledby="hero-heading" data-tasting-hero data-flavor="pies">
  <div class="tasting-coast" aria-hidden="true"><Picture src={coast} formats={['avif','webp']} fallbackFormat="webp" widths={[480,800,1200,1600]} sizes="(max-width: 600px) 100vw, 95vw" width={1536} height={1024} quality={40} alt="" loading="eager" fetchpriority="high" decoding="sync" /></div>
  <div class="tasting-copy">
    <p class="hero-eyebrow">ГОТОВИМСЯ К ЗАПУСКУ · БАЛТИЙСКОЕ ПОБЕРЕЖЬЕ</p>
    <h1 id="hero-heading">Пироги<br />с балтийским<br />характером</h1>
    <p class="tasting-description">Пироги, хлеб и десерты к вашему столу. Изучаем интерес к доставке в трёх городах.</p>
    <div class="hero-actions"><a class="button hero-cta" data-tasting-cta href="/menu/">Смотреть меню<Icon name="arrow" /></a><a class="hero-planner" href="/podbor/">Сколько взять?<Icon name="arrow" /></a></div>
    <p class="tasting-cities">Зеленоградск · Светлогорск · Калининград</p>
  </div>
  <div class="tasting-stage">
    <div class="tasting-orbit" aria-hidden="true"></div>
    <div class="tasting-art" data-tasting-art>
      {slides.map((slide, i) => <div class="tasting-scene" data-tasting-scene={slide.id} hidden={i !== 0}>
        {slide.id === 'company' ? <Picture src={slide.image} formats={['avif','webp']} fallbackFormat="webp" widths={[480,640,800,1120]} sizes="(max-width: 760px) 88vw, 42vw" width={1680} height={672} quality={48} alt={slide.alt} loading="lazy" fetchpriority="low" /> : <Picture src={slide.image} formats={['avif','webp']} fallbackFormat="webp" widths={[320,480,640,800,1000]} sizes="(max-width: 760px) 76vw, (max-width: 1200px) 42vw, 540px" width={900} height={900} quality={48} alt={slide.alt} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'low'} />}
      </div>)}
    </div>
    <div class="tasting-caption" aria-live="polite" aria-atomic="true"><span data-tasting-count>01 / 03</span><div><strong data-tasting-title>{slides[0]!.title}</strong><small data-tasting-note>{slides[0]!.note}</small></div><span class="tasting-weight">Цены<br /><b>предварительные</b></span></div>
    <div class="tasting-nav" role="group" aria-label="Слайды главной страницы">
      <button class="tasting-arrow" type="button" data-tasting-prev aria-label="Предыдущий слайд"><span aria-hidden="true">‹</span></button>
      <div class="tasting-controls" role="group" aria-label="Выбрать раздел">
        {slides.map((slide,i) => <button type="button" data-tasting-select={slide.id} data-name={slide.title} data-note={slide.note} data-href={slide.href} data-cta={slide.cta} aria-label={`Слайд ${i + 1}: ${slide.eyebrow.toLowerCase()}`} aria-pressed={i === 0}><span class="sr-only">{slide.eyebrow}</span></button>)}
      </div>
      <button class="tasting-arrow" type="button" data-tasting-next aria-label="Следующий слайд"><span aria-hidden="true">›</span></button>
    </div>
  </div>
</section>
<script>import '../scripts/design-motion.ts';</script>
