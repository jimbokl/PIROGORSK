---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import fish from '../../design/art-direction-20261030/hero-fish-scene.png';
import cherry from '../../design/layered-assets-v2/cherry/pie.png';
import bundle from '../../design/assets-source/bundle.png';
import '../styles/tasting-hero.css';
const slides = [
  { id: 'pies', eyebrow: 'ПИРОГИ К ВАШЕМУ СТОЛУ', title: 'Пироги к общему столу', note: 'Сытные, сладкие — выбирайте свой.', href: '/menu/', cta: 'Смотреть меню', image: fish, alt: 'Рыбный пирог с открытой начинкой на керамическом блюде' },
  { id: 'company', eyebrow: 'КОГДА СОБИРАЕТСЯ КОМПАНИЯ', title: 'Соберите общий стол', note: 'Несколько пирогов с разными начинками.', href: '#nabory', cta: 'Подобрать набор', image: bundle, alt: 'Пироги для общего стола' },
  { id: 'tea', eyebrow: 'К ЧАЮ И МОРСКОЙ ПРОГУЛКЕ', title: 'Ягодный пирог', note: 'Вишнёвый вкус среди первых идей меню.', href: '/menu/', cta: 'Выбрать пироги', image: cherry, alt: 'Пирог с вишней' },
];
---
<section class="tasting-hero container" aria-labelledby="hero-heading" data-tasting-hero data-flavor="pies" aria-live="polite" aria-atomic="false">
  <div class="tasting-copy">
    <p class="hero-eyebrow">С БАЛТИЙСКИМ ХАРАКТЕРОМ</p>
    <h1 id="hero-heading" data-tasting-title>{slides[0]!.title}</h1>
    <p class="tasting-description" data-tasting-note>{slides[0]!.note}</p>
    <a class="hero-cta" data-tasting-cta href="/menu/">Смотреть меню<Icon name="arrow" /></a>
  </div>
  <div class="tasting-stage">
    <div class="tasting-art" data-tasting-art>
      {slides.map((slide, i) => <div class="tasting-scene" data-tasting-scene={slide.id} hidden={i !== 0}>
        {slide.id === 'company' ? <Picture src={slide.image} formats={['avif','webp']} fallbackFormat="webp" widths={[480,640,800,1120]} sizes="(max-width: 600px) 48vw, (max-width: 1000px) 46vw, 540px" width={1680} height={672} quality={48} alt={slide.alt} loading="lazy" fetchpriority="low" /> : <Picture src={slide.image} formats={['avif','webp']} fallbackFormat="webp" widths={[320,480,640,800,1000]} sizes="(max-width: 600px) 48vw, (max-width: 1000px) 46vw, 540px" width={900} height={slide.id === 'pies' ? 600 : 900} quality={48} alt={slide.alt} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'low'} />}
      </div>)}
    </div>
    <div class="tasting-nav" role="group" aria-label="Слайды главной страницы">
      <button class="tasting-arrow" type="button" data-tasting-prev aria-label="Предыдущий слайд"><span aria-hidden="true">‹</span></button>
      <div class="tasting-controls" role="group" aria-label="Выбрать раздел">
        {slides.map((slide,i) => <button type="button" data-tasting-select={slide.id} data-name={slide.title} data-note={slide.note} data-href={slide.href} data-cta={slide.cta} aria-label={`Слайд ${i + 1}: ${slide.eyebrow.toLowerCase()}`} aria-pressed={i === 0}><span class="sr-only">{slide.eyebrow}</span></button>)}
      </div>
      <button class="tasting-arrow" type="button" data-tasting-next aria-label="Следующий слайд"><span aria-hidden="true">›</span></button>
    </div>
  </div>
</section>
<script>import '../scripts/design-motion.ts';</script>
