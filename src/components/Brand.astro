---
import { Image } from 'astro:assets';
import tower from '../../design/layered-assets-v2/logo/tower-compact-symbol.png';
interface Props { href?: string; footer?: boolean }
const { href = '/', footer = false } = Astro.props;
---
<a class:list={['pirogorsk-brand', { 'pirogorsk-brand--footer': footer }]} href={href} aria-label="Пирогорск — главная">
  <Image src={tower} format="webp" width={56} height={56} quality={90} alt="" aria-hidden="true" class="pirogorsk-brand-symbol" loading="eager" />
  <span class="pirogorsk-brand-copy"><span class="pirogorsk-brand-name">ПИРОГОРСК</span><span class="pirogorsk-brand-tagline">Пироги с балтийским характером</span></span>
</a>
<style>
  .pirogorsk-brand{display:inline-flex;align-items:center;gap:9px;flex-shrink:0;color:#113e50;text-decoration:none}
  .pirogorsk-brand-symbol{width:48px;height:54px;object-fit:contain;flex-shrink:0}
  .pirogorsk-brand-copy{display:flex;flex-direction:column;gap:4px}
  .pirogorsk-brand-name{font-family:'Playfair Display',Georgia,serif;font-size:31px;line-height:1;font-weight:700;letter-spacing:-.045em}
  .pirogorsk-brand-tagline{font-size:10px;line-height:1.3;letter-spacing:.015em}
  .pirogorsk-brand--footer .pirogorsk-brand-name{font-size:27px}
  @media(max-width:1190px){.pirogorsk-brand-symbol{width:40px;height:48px}.pirogorsk-brand-name{font-size:28px}.pirogorsk-brand-tagline{font-size:9px}.pirogorsk-brand{gap:6px}}
  @media(max-width:600px){.pirogorsk-brand{gap:5px}.pirogorsk-brand-symbol{width:29px;height:40px}.pirogorsk-brand-name{font-size:22px}.pirogorsk-brand-tagline{font-size:7px;letter-spacing:0}.pirogorsk-brand-copy{gap:3px}}
  @media(max-width:370px){.pirogorsk-brand-symbol{width:23px;height:34px}.pirogorsk-brand-name{font-size:18px}.pirogorsk-brand-tagline{font-size:6px}}
</style>
