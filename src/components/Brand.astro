---
interface Props { href?: string; footer?: boolean; masthead?: boolean }
const { href = '/', footer = false, masthead = false } = Astro.props;
---
<a class:list={['pirogorsk-brand', { 'pirogorsk-brand--footer': footer, 'pirogorsk-brand--masthead': masthead }]} href={href} aria-label="Пирогорск — на главную">
  <img
    src="/brand/pirogorsk-logo-640.webp?v=6"
    srcset="/brand/pirogorsk-logo-400.webp?v=6 400w, /brand/pirogorsk-logo-640.webp?v=6 640w, /brand/pirogorsk-logo-960.webp?v=6 960w"
    sizes={footer ? '(max-width: 600px) 240px, 280px' : '(max-width: 370px) 176px, (max-width: 600px) 224px, (max-width: 1000px) 280px, 312px'}
    width="2089" height="753" alt="" aria-hidden="true" decoding="async" loading={footer ? 'lazy' : 'eager'}
    class="pirogorsk-brand-logo"
  />
</a>
<style>
  .pirogorsk-brand{display:block;flex-shrink:0;width:280px;max-width:100%;text-decoration:none}
  .pirogorsk-brand-logo{display:block;width:100%;height:auto}
  .pirogorsk-brand--masthead{width:min(312px,calc(100vw - var(--page-gutter)*2 - 560px))}
  .pirogorsk-brand--footer{width:280px}
  @media(max-width:1190px){.pirogorsk-brand--masthead{width:min(280px,calc(100vw - var(--page-gutter)*2 - 400px))}}
  @media(max-width:1100px){.pirogorsk-brand--masthead{width:280px}}
  @media(max-width:600px){.pirogorsk-brand--masthead{width:min(224px,calc(100vw - var(--page-gutter)*2 - 104px))}.pirogorsk-brand--footer{width:240px}}
</style>
