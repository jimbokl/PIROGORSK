---
interface Props { title: string; id: string; }
const { title, id } = Astro.props;
---
<details class="product-disclosure" aria-labelledby={id} data-product-disclosure>
  <summary><h2 id={id}>{title}</h2><svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m5 8 5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
  <div class="disclosure-body"><slot /></div>
</details>
<style>
  .product-disclosure{margin-block:12px;border:1px solid var(--brand-line);border-radius:20px;background:var(--brand-paper);overflow:clip}
  summary{display:flex;align-items:center;justify-content:space-between;gap:20px;min-height:76px;padding:20px 26px;cursor:pointer;list-style:none;color:var(--navy)}
  summary::-webkit-details-marker{display:none}summary::marker{content:''}summary h2{font:600 clamp(16px,1.8vw,20px)/1.4 var(--sans);letter-spacing:-.02em;margin:0}summary svg{flex-shrink:0;color:var(--brand-ink);transition:transform .2s}
  [open]>summary svg{transform:rotate(180deg)}[open]>summary{border-bottom:1px solid var(--brand-line)}
  summary:hover{background:#fff8eb}summary:focus-visible{outline:2px solid var(--accent);outline-offset:-4px;border-radius:18px}
  .disclosure-body{padding:24px 26px 28px;background:#fff}
  @media(max-width:760px){summary{min-height:68px;padding:18px 20px}.disclosure-body{padding:22px 20px}}
  @media(prefers-reduced-motion:reduce){summary svg{transition:none}}
</style>
