---
import type { EditorialLink } from '../data/editorial';
import { isConversionHref } from '../lib/seo-navigation';
import SceneCard from './SceneCard.astro';
import { editorialCardArtwork } from '../data/editorial-card-artwork';
import '../styles/editorial-cards.css';
interface Props { title: string; links: readonly EditorialLink[]; id?: string }
const { title, links, id } = Astro.props;
---
<section class="ed-links-section" id={id}>
  <h2>{title}</h2>
  <div class="ed-link-grid">
    {links.map((link, index) => {
      const art = editorialCardArtwork(link.href);
      const wideDesktop = links.length === 2 || (links.length === 5 && index >= 3);
      const wideTablet = links.length % 2 === 1 && index === links.length - 1;
      const sizes = `(max-width: 599px) calc(100vw - 40px), (max-width: 1099px) ${wideTablet ? '90vw' : '45vw'}, ${wideDesktop ? '45vw' : '30vw'}`;
      return <SceneCard href={link.href} title={link.title} text={link.text}
        label={link.label ?? 'Пирогорск'} image={art.image} action={art.action}
        kind={art.kind} {sizes} conversion={isConversionHref(link.href)} />;
    })}
  </div>
</section>
