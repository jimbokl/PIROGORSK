---
interface Props { eyebrow: string; title: string; intro: string }
const { eyebrow, title, intro } = Astro.props;
---
<section class="product-hero" aria-labelledby="product-heading">
  <div class="product-hero-copy">
    <p class="ed-eyebrow">{eyebrow}</p>
    <h1 id="product-heading">{title}</h1>
    <p class="product-hero-intro">{intro}</p>
  </div>
  <figure class="product-hero-art">
    <div class="product-hero-frame"><slot name="visual" /></div>
  </figure>
  <div class="product-hero-actions"><slot name="actions" /></div>
</section>
<style>
  .product-hero{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));grid-template-rows:auto 1fr;grid-template-areas:'art copy' 'art actions';column-gap:40px;align-items:start;padding-block:32px 56px}
  .product-hero-copy{grid-area:copy;min-width:0}
  .product-hero h1{font:500 clamp(34px,3.9vw,52px)/1.1 var(--ed-serif);letter-spacing:-.035em;text-wrap:pretty;overflow-wrap:anywhere;margin-top:12px}
  .product-hero-intro{font-size:15px;line-height:1.75;color:var(--ed-muted);margin-top:18px;max-width:58ch}
  .product-hero-art{grid-area:art;width:100%;max-width:520px;min-width:0;justify-self:center}
  .product-hero-frame{padding:18px;border:0;border-radius:var(--radius-card);background:var(--surface-oat)}
  .product-hero-frame :global(.product-visual),.product-hero-frame :global(.product-artwork){width:100%;aspect-ratio:1;border-radius:20px}
  .product-hero-actions{grid-area:actions;min-width:0;padding-top:24px}
  @media(max-width:1000px){.product-hero{column-gap:28px}.product-hero h1{font-size:36px}}
  @media(max-width:760px){
    .product-hero{grid-template-columns:minmax(0,1fr);grid-template-rows:auto;grid-template-areas:'copy' 'art' 'actions';gap:22px;padding-block:24px 36px}
    .product-hero h1{font-size:clamp(30px,8.2vw,36px)}
    .product-hero-intro{font-size:14px;line-height:1.7;margin-top:14px}
    .product-hero-art{max-width:380px}
    .product-hero-actions{padding-top:0}
  }
</style>
