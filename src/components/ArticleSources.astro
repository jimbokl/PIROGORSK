---
import type { ArticleSource } from '../data/blog-articles';
interface Props { sources: readonly ArticleSource[] }
const { sources } = Astro.props;
const date = (value: string) => new Intl.DateTimeFormat('ru-RU', { timeZone: 'UTC' }).format(new Date(`${value}T00:00:00Z`));
---
<section class="article-sources" id="sources" aria-labelledby="sources-title">
  <p class="ed-eyebrow">Основа материала</p>
  <h2 id="sources-title">Источники и расчёты</h2>
  <p>Автор — <a href="/about/#redaktsiya">редакция проекта «Пирогорск»</a>. Внешние сведения сверены с указанными материалами. Сравнения, списки для покупок и условные расчёты подготовлены редакцией; их исходные данные приведены в статье.</p>
  <ol>{sources.map(source => <li><a href={source.href}>{source.title}<span aria-hidden="true"> ↗</span></a><small>Проверено <time datetime={source.checked}>{date(source.checked)}</time></small></li>)}</ol>
  <a class="article-method" href="/about/#redaktsiya">Как готовим статьи и иллюстрации <span aria-hidden="true">↗</span></a>
</section>
<style>
  .article-sources{margin-top:44px;padding:clamp(22px,4vw,40px);border:1px solid var(--ed-line);border-radius:20px;background:var(--ed-paper,#fff);scroll-margin-top:120px;min-width:0}.article-sources h2{font:500 clamp(27px,3vw,36px)/1.2 var(--ed-serif);letter-spacing:-.025em;margin:12px 0 18px}.article-sources>p:not(.ed-eyebrow){font-size:14px;line-height:1.8;color:var(--ed-muted);max-width:78ch}.article-sources a{color:var(--ed-amber);text-underline-offset:4px;overflow-wrap:anywhere}.article-sources ol{padding-left:22px;margin:22px 0}.article-sources li{padding:12px 0;font-size:14px;line-height:1.7}.article-sources small{display:block;color:var(--ed-muted);font-size:12px;margin-top:4px}.article-method{display:inline-flex;align-items:center;gap:20px;min-height:44px;font-size:13px}
</style>
