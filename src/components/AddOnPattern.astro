<style>
  .addon-pattern{position:absolute;inset:0 0 auto auto;width:240px;height:160px;color:var(--addon-pattern-ink,#a47845);opacity:.22;pointer-events:none;z-index:-1;overflow:hidden;border-top-right-radius:inherit}
