---
import SceneCard from './SceneCard.astro';
import apartment from '../../design/editorial-cards-20261101/dinner.png';
import picnic from '../../design/blog-source/reading-20261101/picnic.png';
import company from '../../design/editorial-cards-20261101/gathering.png';
const entries = [
  { href: '/nabor/uzhin-v-apartamentah/?pg_channel=scenario', title: 'В апартаменты', text: 'Спокойный ужин у моря', image: apartment, kind: 'dinner' },
  { href: '/nabor/piknik-u-morya/?pg_channel=scenario', title: 'На пикник', text: 'Взять с собой на берег', image: picnic, kind: 'picnic' },
  { href: '/nabor/na-kompaniyu/?pg_channel=scenario', title: 'На компанию', text: 'Несколько вкусов для друзей', image: company, kind: 'gathering' },
];
---
<nav class="scenario-entries" aria-label="Подобрать пироги к случаю">
  <div class="scenario-heading"><span>К какому столу?</span><span class="scenario-hint" aria-hidden="true">Листайте →</span></div>
  <div class="scenario-rail">{entries.map(entry => <SceneCard {...entry} compact conversion sizes="(max-width:599px) 280px, (max-width:1099px) 30vw, 350px" />)}</div>
</nav>
<script>
  document.querySelectorAll<HTMLElement>('.scenario-rail').forEach(rail => {
    rail.addEventListener('focusin', event => {
      const card = event.target instanceof Element ? event.target.closest<HTMLElement>('.scene-card') : null;
      if (!card || card.parentElement !== rail) return;
      const bounds = rail.getBoundingClientRect();
      const rect = card.getBoundingClientRect();
      // Keep the complete card and focus ring visible in the horizontal rail.
      const offset = rect.left < bounds.left + 8 ? rect.left - bounds.left - 8
        : rect.right > bounds.right - 8 ? rect.right - bounds.right + 8 : 0;
      if (offset) rail.scrollBy({ left: offset, behavior: 'instant' });
    });
  });
</script>
<style>
.scenario-entries{margin:14px 0 26px;font-family:var(--sans)}
.scenario-heading{display:flex;align-items:baseline;justify-content:space-between;gap:16px;margin-bottom:12px;font-size:14px;font-weight:500;color:var(--navy)}
.scenario-hint{display:none;color:var(--muted);font-size:11px;font-weight:400}
.scenario-rail{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;max-width:1100px}
@media(max-width:599px){.scenario-hint{display:block}.scenario-rail{grid-template-columns:none;grid-auto-flow:column;grid-auto-columns:min(280px,86%);gap:12px;overflow-x:auto;scroll-snap-type:x proximity;scroll-padding-inline:8px;padding:8px 8px 12px;margin:-8px;overscroll-behavior-x:contain;scrollbar-width:thin;scrollbar-color:#c9b797 transparent}.scenario-rail :global(.scene-card){scroll-snap-align:start}}
</style>
