---
import { catalog } from '../data/catalog';
import { bundles } from '../data/bundles';
import { selectionPrice } from '../lib/selection-offers';
import { catalogProductHref } from '../lib/product-paths';
import SupplierArtwork from './SupplierArtwork.astro';
import ProductVisual from './ProductVisual.astro';
import Icon from './Icon.astro';
interface Props { embedded?: boolean }
const { embedded = false } = Astro.props;
const money = (price: number) => `${price.toLocaleString('ru-RU')} ₽`;
---
<section class:list={['home-offers', { container: !embedded }]} id="nabory" aria-labelledby="home-offers-heading">
  <div class="offers-heading">
    <div><span class="offers-kicker">ДЛЯ ОБЩЕГО СТОЛА</span><h2 id="home-offers-heading">Начните с набора</h2></div>
    <p>Выберите сочетание, а морс и посуду добавьте по желанию. Состав можно изменить.</p>
  </div>
  <div class="offers-grid">
    {bundles.map(bundle => <article class="offer-card">
      <div class="offer-art" aria-hidden="true">{bundle.items.map(item => item.id.startsWith('p39-') ? <SupplierArtwork id={item.id} sizes="(max-width:700px) 90px, 180px" decorative /> : <ProductVisual product={catalog.find(product => product.id === item.id)!} decorative />)}</div>
      <div class="offer-body">
        <p class="offer-note">{bundle.note}</p>
        <h3><a class="offer-title" href={bundle.href}>{bundle.title}</a></h3>
        <ul>{bundle.items.map(item => {
          const product = catalog.find(product => product.id === item.id)!;
          const variant = product.variants.find(variant => variant.value === item.value)!;
          return <li><a href={catalogProductHref(product)}>{product.name}</a><span>{variant.label.replace('Целый · ', '')}</span></li>;
        })}</ul>
        <div class="offer-bottom"><div><strong>{money(selectionPrice(bundle.items, catalog))}</strong><small>сумма позиций · предварительно</small></div><a class="button offer-add" data-bundle={bundle.id} href={`/?interest=bundle&bundle=${bundle.id}#nabory`} aria-label={`В подборку: ${bundle.title}`}>В подборку<Icon name="arrow" /></a></div>
      </div>
    </article>)}
  </div>
  <div class="offers-footnote"><span>Доставка один раз за всю подборку, отдельно от цены набора. Заказы пока не принимаем.</span><nav aria-label="Подробнее о выборе пирогов"><a href="/povody/">Подобрать к случаю<Icon name="arrow" /></a><a href="/podbor/">Сколько взять?<Icon name="arrow" /></a></nav></div>
</section>
<style>
  .home-offers{padding:34px 0 30px}
  .offers-heading{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:20px}
  .offers-kicker{display:block;color:var(--muted);font-size:10px;letter-spacing:.13em;margin-bottom:8px}
  .offers-heading h2{font:600 var(--heading-section)/1.12 var(--serif);margin:0;letter-spacing:-.035em}
  .offers-heading>p{font-size:13px;line-height:1.7;color:var(--muted);max-width:320px;margin:0}
  .offers-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
  .offer-card{display:flex;flex-direction:column;overflow:hidden;background:var(--paper-raised,var(--paper));border:1px solid var(--line);border-radius:var(--radius-card)}
  .offer-art{display:flex;align-items:center;aspect-ratio:2.5;padding:8px;background:var(--paper);overflow:hidden}
  .offer-art :global(.product-visual-badge){display:none}
  .offer-art :global(:is(.product-visual,.product-artwork)){flex:1;min-width:0;width:0;aspect-ratio:1;height:auto;margin:0!important}
  .offer-body{display:flex;flex:1;flex-direction:column;min-width:0;padding:20px}
  .offer-note{font:400 11px/1.6 var(--sans);color:var(--muted);margin:0 0 10px;min-height:36px}
  .offer-body h3{font:600 26px/1.2 var(--serif);letter-spacing:-.025em;margin:0 0 16px;min-height:63px}
  .offer-title{text-decoration:none}.offer-title:hover{text-decoration:underline;text-underline-offset:4px}
  .offer-body ul{list-style:none;padding:0;margin:0 0 20px;font:400 12px/1.6 var(--sans)}
  .offer-body li{display:flex;justify-content:space-between;gap:12px;margin-bottom:8px}.offer-body li a{text-decoration:underline;text-decoration-color:var(--line);text-underline-offset:3px}.offer-body li span{white-space:nowrap;color:var(--muted)}
  .offer-bottom{display:flex;flex-direction:column;gap:16px;margin-top:auto}
  .offer-bottom>div{display:flex;flex-direction:column;gap:4px}.offer-bottom strong{font:600 24px/1.3 var(--sans);font-variant-numeric:tabular-nums}.offer-bottom small{font-size:11px;color:var(--muted)}
  .offer-add{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:48px;width:100%;padding:12px 20px;border-radius:var(--radius-pill);background:var(--navy);color:var(--paper);font:600 14px/1.4 var(--sans);text-decoration:none;text-align:center}
  .offer-add:hover{background:var(--navy-deep)}.offer-add:focus-visible,.offer-body a:focus-visible{outline:3px solid var(--focus);outline-offset:4px}.offer-add .icon{width:16px;height:16px}
  .offers-footnote{display:flex;justify-content:space-between;gap:16px;margin-top:16px;font:400 12px/1.7 var(--sans);color:var(--muted)}.offers-footnote>span{max-width:600px}
  .offers-footnote nav{display:flex;flex-wrap:wrap;align-items:start;gap:18px;flex-shrink:0}.offers-footnote a{display:inline-flex;align-items:center;gap:5px;min-height:44px;color:var(--navy);text-underline-offset:3px}.offers-footnote .icon{width:14px;height:14px}
  @media(max-width:1000px){.offers-grid{gap:12px}.offer-body{padding:16px}.offer-body h3{font-size:23px;min-height:56px}.offers-footnote{flex-direction:column}}
  @media(max-width:700px){.home-offers{padding:26px 0}.offers-heading{display:block}.offers-heading>p{margin-top:12px}.offers-grid{grid-template-columns:minmax(0,1fr)}.offer-card{display:grid;grid-template-columns:28% minmax(0,1fr)}.offer-art{flex-direction:column;aspect-ratio:auto;padding:6px;justify-content:center}.offer-art :global(:is(.product-visual,.product-artwork)){width:100%;flex:0 0 auto}.offer-body h3{min-height:0;font-size:24px;margin-bottom:12px}.offer-note{min-height:0;margin-bottom:8px}.offer-body ul{margin-bottom:14px}.offer-body li{flex-wrap:wrap;gap:0 8px}.offer-bottom{gap:12px}.offers-footnote nav{gap:14px}}
</style>
