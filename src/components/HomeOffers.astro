---
import { catalog } from '../data/catalog';
import { bundles } from '../data/bundles';
import { selectionPrice } from '../lib/selection-offers';
import { compositionSummary } from '../lib/composition-summary';
import { catalogProductHref } from '../lib/product-paths';
import SupplierArtwork from './SupplierArtwork.astro';
import ProductVisual from './ProductVisual.astro';
import Icon from './Icon.astro';
interface Props { embedded?: boolean }
const { embedded = false } = Astro.props;
const money = (price: number) => `${price.toLocaleString('ru-RU')} ₽`;
---
<section class:list={['home-offers', { container: !embedded }]} id="nabory" aria-labelledby="home-offers-heading">
  <div class="offers-heading">
    <div><span class="offers-kicker">НЕСКОЛЬКО ВКУСОВ · ОДНА ПОДБОРКА</span><h2 id="home-offers-heading">К столу — всё вместе</h2></div>
    <p>Готовые сочетания для ужина и встречи с друзьями. Всё можно изменить под себя.</p>
  </div>
  <div class="offers-grid">
    {bundles.map(bundle => <article class="offer-card">
      <div class="offer-art" aria-hidden="true">{bundle.items.map(item => item.id.startsWith('p39-') ? <SupplierArtwork id={item.id} sizes="(max-width:700px) 90px, 180px" decorative /> : <ProductVisual product={catalog.find(product => product.id === item.id)!} decorative />)}</div>
      <div class="offer-body">
        <h3><a class="offer-title" href={bundle.href}>{bundle.title}</a></h3>
        <p class="offer-note">{bundle.note}</p>
        <ul>{bundle.items.map(item => {
          const product = catalog.find(product => product.id === item.id)!;
          const variant = product.variants.find(variant => variant.value === item.value)!;
          return <li><a href={catalogProductHref(product)}>{product.name}</a><span>{variant.label.replace('Целый · ', '')}</span></li>;
        })}</ul>
        <p class="offer-portions" data-offer-summary={bundle.id}>{compositionSummary(bundle.items, catalog)!.text}</p>
        <div class="offer-bottom"><div><strong>{money(selectionPrice(bundle.items, catalog))}</strong><small>сумма позиций · предварительно</small></div><a class="button offer-add" data-bundle={bundle.id} href={`/?interest=bundle&bundle=${bundle.id}#nabory`} aria-label={`В подборку: ${bundle.title}`}>В подборку<Icon name="arrow" /></a></div>
        <a class="offer-edit" data-edit-bundle={bundle.id} href={`/?interest=edit-bundle&bundle=${bundle.id}`} aria-label={`Изменить состав: ${bundle.title}`}>Изменить состав</a>
      </div>
    </article>)}
  </div>
  <div class="offers-footnote"><span>Ориентир — 250 г пирога на порцию. Морс и посуду можно добавить в подборке. Доставка отдельно, один раз за весь состав. Заказы пока не принимаем.</span><nav aria-label="Подробнее о выборе пирогов"><a href="/povody/">Подобрать к случаю<Icon name="arrow" /></a><a href="/podbor/">Сколько взять?<Icon name="arrow" /></a></nav></div>
</section>
<style>
.home-offers{padding:12px 0 48px}
.offers-heading{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:28px}
.offers-kicker{display:block;color:var(--muted);font-size:10px;letter-spacing:.1em;margin-bottom:10px}
.offers-heading h2{font:500 var(--heading-section)/1.15 var(--serif);margin:0;letter-spacing:-.03em}
.offers-heading>p{font-size:14px;line-height:1.65;color:var(--muted);max-width:320px;margin:0}
.offers-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}
.offer-card{display:flex;flex-direction:column;min-width:0;overflow:hidden;background:var(--paper);border:1px solid var(--line);border-radius:24px;box-shadow:none}
.offer-art{position:relative;display:flex;align-items:center;justify-content:center;height:180px;padding:8px 16px;background:var(--surface-oat);overflow:hidden}
.offer-card:nth-child(2) .offer-art{background:var(--surface-sage)}.offer-card:nth-child(3) .offer-art{background:var(--surface-berry)}
.offer-card:nth-child(4) .offer-art{background:var(--surface-sage)}.offer-card:nth-child(5) .offer-art{background:var(--surface-berry)}
.offer-art :global(.product-visual-badge),.offer-art :global(.product-backdrop),.offer-art :global(.product-visual-background){display:none}
.offer-art :global(:is(.product-visual,.product-artwork)){flex:1;min-width:0;width:0;aspect-ratio:1;height:auto;max-height:180px;margin:0!important;overflow:visible;background:transparent}
.offer-art :global(.product-artwork-subject){inset:0;mask-image:none;mix-blend-mode:normal}
.offer-art :global(.product-visual-subject){width:112%;top:50%}
.offer-art :global(:is(.product-visual,.product-artwork)):nth-child(2){margin-left:-12px!important;transform:translateY(12px)}
.offer-art :global(:is(.product-visual,.product-artwork)):nth-child(3){margin-left:-12px!important;transform:translateY(-4px)}
.offer-body{display:flex;flex:1;flex-direction:column;min-width:0;padding:24px}
.offer-body h3{font:500 26px/1.15 var(--serif);letter-spacing:-.025em;margin:0 0 9px;min-height:52px}
.offer-title{text-decoration:none}.offer-title:hover{text-decoration:underline;text-underline-offset:4px}
.offer-note{font:400 12px/1.6 var(--sans);color:var(--muted);margin:0 0 18px;min-height:28px}
.offer-body ul{list-style:none;padding:0;margin:0 0 24px;font:400 12px/1.6 var(--sans)}
.offer-body li{display:flex;justify-content:space-between;gap:10px;margin-bottom:8px}.offer-body li a{text-decoration:none}.offer-body li a:hover{text-decoration:underline;text-underline-offset:3px}.offer-body li span{white-space:nowrap;color:var(--muted)}
.offer-portions{margin:auto 0 18px;padding-top:8px;font:500 12px/1.6 var(--sans);color:var(--navy);font-variant-numeric:tabular-nums}
.offer-bottom{display:flex;align-items:center;justify-content:space-between;gap:12px}
.offer-bottom>div{display:flex;flex-direction:column;gap:4px}.offer-bottom strong{font:600 23px/1.2 var(--sans);letter-spacing:-.035em;font-variant-numeric:tabular-nums}.offer-bottom small{font-size:10px;line-height:1.5;color:var(--muted);max-width:120px}
.offer-add{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:var(--control-height);padding:12px 16px;border-radius:var(--radius-control);background:var(--navy);color:var(--paper);font:500 12px/1.4 var(--sans);text-decoration:none;text-align:center;white-space:nowrap}
.offer-add:hover{background:var(--action-hover)}.offer-add:focus-visible,.offer-body a:focus-visible{outline:3px solid var(--focus);outline-offset:4px}.offer-add :global(.icon){width:15px;height:15px}
.offer-edit{align-self:start;display:inline-flex;align-items:center;min-height:44px;margin-top:8px;font:400 12px/1.5 var(--sans);text-decoration:underline;text-underline-offset:4px;color:var(--muted)}
.offers-footnote{display:flex;justify-content:space-between;gap:20px;margin-top:20px;font:400 11px/1.7 var(--sans);color:var(--muted)}.offers-footnote>span{max-width:560px}
.offers-footnote nav{display:flex;flex-wrap:wrap;gap:18px;flex-shrink:0}.offers-footnote a{display:inline-flex;align-items:center;gap:6px;min-height:44px;color:var(--navy);text-decoration:none}.offers-footnote :global(.icon){width:14px;height:14px}
@media(max-width:1050px){.offers-grid{gap:14px}.offer-body{padding:20px}.offer-bottom{align-items:start;flex-direction:column}.offer-bottom small{max-width:none}.offer-add{width:100%}.offer-art{height:160px}.offer-body h3{font-size:24px;min-height:56px}}
@media(max-width:700px){.home-offers{padding:0 0 32px}.offers-heading{display:block;margin-bottom:22px}.offers-heading>p{margin-top:12px;max-width:42ch}.offers-grid{grid-template-columns:none;grid-auto-flow:column;grid-auto-columns:min(86vw,350px);gap:14px;overflow-x:auto;scroll-snap-type:x proximity;padding-bottom:16px}.offer-card{scroll-snap-align:start}.offer-card{display:grid;grid-template-columns:1fr}.offer-art{height:150px;padding-inline:22px}.offer-art :global(:is(.product-visual,.product-artwork)){max-width:160px}.offer-body{padding:22px}.offer-body h3{min-height:58px;font-size:26px}.offer-note{min-height:32px;margin-bottom:14px}.offer-body ul{margin-bottom:20px;font-size:13px}.offer-bottom{align-items:center;flex-direction:row}.offer-add{width:auto;min-width:120px}.offer-bottom small{max-width:125px}.offers-footnote{flex-direction:column;gap:8px}.offers-kicker{font-size:9px}}
</style>
