---
import type { EditorialSection } from '../data/editorial';
import { isConversionHref } from '../lib/seo-navigation';
interface Props { sections: readonly EditorialSection[] }
const { sections } = Astro.props;
---
<div class="ed-article">{sections.map((section, index) => <section class="ed-article-section" aria-labelledby={`section-${index}`}><h2 id={`section-${index}`}>{section.title}</h2><div>{section.paragraphs?.map(paragraph => <p>{paragraph}</p>)}{section.table && <div class="ed-table-scroll" role="region" aria-label={section.table.caption} tabindex="0"><table class="ed-reading-table"><caption>{section.table.caption}</caption><thead><tr>{section.table.headers.map(heading => <th scope="col">{heading}</th>)}</tr></thead><tbody>{section.table.rows.map(row => <tr>{row.map((cell, cellIndex) => cellIndex === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>)}</tbody></table></div>}{section.items && <ul>{section.items.map(item => <li>{item}</li>)}</ul>}{section.links && <nav class="ed-reading-links" aria-label={`По теме: ${section.title}`}>{section.links.map(link => <a href={link.href} data-guide-catalog={isConversionHref(link.href) ? '' : undefined}>{link.title}<span aria-hidden="true">↗</span></a>)}</nav>}</div></section>)}</div>
<style>
  .ed-article-section,.ed-article-section>div{min-width:0}.ed-table-scroll{max-width:100%;overflow-x:auto;margin-block:25px;border:1px solid var(--ed-line);border-radius:12px}.ed-table-scroll:focus-visible{outline:2px solid var(--ed-amber);outline-offset:4px}.ed-reading-table{width:100%;min-width:440px;border-collapse:collapse;font-size:14px;line-height:1.6;overflow-wrap:break-word}.ed-reading-table caption{text-align:left;font-size:13px;color:var(--ed-muted);padding:14px 12px}.ed-reading-table th,.ed-reading-table td{padding:13px 10px;text-align:left;border-bottom:1px solid var(--ed-line)}.ed-reading-table thead{background:var(--ed-sea)}.ed-reading-table th{font-weight:500}.ed-reading-links{display:grid;gap:6px;margin-top:20px}.ed-reading-links a{min-height:44px;display:flex;align-items:center;justify-content:space-between;gap:14px;color:var(--ed-amber);font-size:13px;text-underline-offset:4px}.ed-reading-links a span{font-size:19px}@media(max-width:420px){.ed-reading-table{font-size:13px}.ed-reading-table th,.ed-reading-table td{padding:12px 10px}}
</style>
