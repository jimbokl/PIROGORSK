---
import type { EditorialSection } from '../data/editorial';
interface Props { sections: readonly EditorialSection[] }
const { sections } = Astro.props;
---
<div class="ed-article">{sections.map((section, index) => <section class="ed-article-section" aria-labelledby={`section-${index}`}><h2 id={`section-${index}`}>{section.title}</h2><div>{section.paragraphs?.map(paragraph => <p>{paragraph}</p>)}{section.table && <table class="ed-reading-table"><caption>{section.table.caption}</caption><thead><tr>{section.table.headers.map(heading => <th scope="col">{heading}</th>)}</tr></thead><tbody>{section.table.rows.map(row => <tr>{row.map((cell, cellIndex) => cellIndex === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>)}</tbody></table>}{section.items && <ul>{section.items.map(item => <li>{item}</li>)}</ul>}{section.links && <nav class="ed-reading-links" aria-label={`По теме: ${section.title}`}>{section.links.map(link => <a href={link.href}>{link.title}<span aria-hidden="true">↗</span></a>)}</nav>}</div></section>)}</div>
<style>
  .ed-article-section>div{min-width:0}.ed-reading-table{width:100%;border-collapse:collapse;font-size:13px;line-height:1.6;margin-block:25px;overflow-wrap:anywhere}.ed-reading-table caption{text-align:left;font-size:12px;color:var(--ed-muted);padding-bottom:12px}.ed-reading-table th,.ed-reading-table td{padding:13px 10px;text-align:left;border-bottom:1px solid var(--ed-line)}.ed-reading-table thead{background:var(--ed-sea)}.ed-reading-table th{font-weight:500}.ed-reading-links{display:grid;gap:6px;margin-top:20px}.ed-reading-links a{min-height:44px;display:flex;align-items:center;justify-content:space-between;gap:14px;color:var(--ed-amber);font-size:13px;text-underline-offset:4px}.ed-reading-links a span{font-size:19px}@media(max-width:420px){.ed-reading-table{font-size:11px}.ed-reading-table th,.ed-reading-table td{padding:11px 6px}}
</style>
