---
interface Props { links: readonly { href: string; title: string }[] }
const { links } = Astro.props;
---
<div class="article-reading">
  <aside class="article-reading-nav">
    <details class="article-contents" open>
      <summary><span><span class="article-contents-kicker">В этом материале</span><strong>Содержание</strong></span><span class="article-contents-toggle" aria-hidden="true">⌄</span></summary>
      <nav aria-label="Содержание статьи"><ol>{links.map(link => <li><a href={link.href}>{link.title}</a></li>)}</ol></nav>
    </details>
  </aside>
  <div class="article-reading-main"><slot /></div>
</div>
