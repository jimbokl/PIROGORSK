---
import { Picture } from 'astro:assets';
import town from '../../design/pie-city-banners-20261030/pie-islands.png';
import { interestHref } from '../data/editorial';
interface Props { interest?: string; title?: string; text?: string; label?: string }
const { interest, title = 'Хотели бы попробовать?', text = 'Выберите интересные вкусы на главной. Так мы поймём, что стоит подготовить к запуску. Заказ и оплата пока недоступны.', label = 'Отметить интерес' } = Astro.props;
---
<aside class="ed-interest town-invitation"><Picture src={town} formats={['avif', 'webp']} fallbackFormat="webp" widths={[160, 240, 360]} sizes="(max-width: 600px) 90px, 160px" width={160} height={160} quality={55} loading="lazy" alt="" /><div><p class="ed-eyebrow">Перед запуском</p><h2>{title}</h2><p>{text}</p></div><a class="ed-button" data-guide-catalog href={interestHref(interest)}>{label}<span aria-hidden="true">↗</span></a></aside>

<style>
  .ed-interest.town-invitation{display:grid;grid-template-columns:160px minmax(0,1fr);gap:14px 30px;padding:30px 36px;border:1px solid var(--ed-line);border-radius:26px;background:linear-gradient(110deg,#f4f8fc,#fcf9f2)}.town-invitation :global(picture){grid-row:1/3;align-self:center}.town-invitation :global(img){display:block;width:160px;height:160px;object-fit:contain}.town-invitation .ed-button{grid-column:2;justify-self:start;min-height:48px;margin-top:0}.town-invitation h2{font-size:clamp(27px,3vw,36px);line-height:1.15;letter-spacing:-.035em}.town-invitation>div>p:last-child{max-width:64ch}.town-invitation .ed-eyebrow{color:var(--ed-muted)}
  @media(max-width:600px){.ed-interest.town-invitation{grid-template-columns:90px minmax(0,1fr);padding:24px 20px;gap:16px 14px;border-radius:22px}.town-invitation :global(picture){grid-row:1}.town-invitation :global(img){width:90px;height:90px}.town-invitation h2{font-size:27px}.town-invitation>div>p:last-child{font-size:12px;line-height:1.8}.town-invitation .ed-button{grid-column:1/-1;max-width:100%;font-size:12px}.town-invitation .ed-eyebrow{font-size:8px}}
</style>
