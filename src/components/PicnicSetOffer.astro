---
import { extras } from '../data/catalog';
import ProductVisual from './ProductVisual.astro';
const product = extras.find(product => product.id === 'picnic-set')!;
---
<section class="picnic-offer" aria-labelledby="picnic-offer-heading" data-picnic-offer>
  <a class="picnic-offer-art" href="/catalog/baltiyskiy-piknik-set/" aria-label="Балтийский пикник-сет — состав и цена"><ProductVisual {product} layout="menu" sizes="(max-width: 700px) 280px, 340px" decorative /></a>
  <div class="picnic-offer-copy"><p class="ed-eyebrow">К пирогу на прогулку</p><h2 id="picnic-offer-heading"><a href="/catalog/baltiyskiy-piknik-set/">Балтийский пикник-сет</a></h2><p>Нарезка пирога на восемь кусочков в бумажных лодочках, чай с мёдом на двоих, салфетки и пакет для чистого берега.</p><p class="picnic-offer-note">Пирог выбирается отдельно. Кипяток возьмите в термосе.</p><div class="picnic-offer-actions"><strong>350 ₽ <span>за сет на двоих</span></strong><a class="ed-button" href="/catalog/baltiyskiy-piknik-set/">Посмотреть состав <span aria-hidden="true">→</span></a></div></div>
</section>
<style>
  .picnic-offer{display:grid;grid-template-columns:minmax(240px,.8fr) minmax(0,1.2fr);gap:clamp(24px,5vw,64px);align-items:center;border:1px solid var(--ed-line);border-radius:28px;background:var(--paper-raised);padding:clamp(24px,4vw,48px);margin:32px 0 56px}
  .picnic-offer-art{display:block;width:100%;max-width:340px;justify-self:center}.picnic-offer-art :global(.product-visual){aspect-ratio:1;margin:0!important}
  h2{font:500 clamp(28px,4vw,42px)/1.12 var(--ed-serif);letter-spacing:-.03em;margin:14px 0 18px}h2 a{color:inherit;text-decoration:none}h2 a:hover{text-decoration:underline;text-decoration-color:var(--copper,#a76525);text-underline-offset:5px}
  .picnic-offer-copy>p{font-size:14px;line-height:1.8}.picnic-offer-copy .ed-eyebrow{font-size:11px}.picnic-offer-note{color:var(--ed-muted)}
  .picnic-offer-actions{display:flex;flex-wrap:wrap;align-items:center;gap:20px;margin-top:24px}.picnic-offer-actions strong{font-size:28px;font-variant-numeric:tabular-nums}.picnic-offer-actions strong span{display:block;font-size:11px;font-weight:400;color:var(--ed-muted);margin-top:4px}.picnic-offer-actions a{font-size:13px}
  @media(max-width:700px){.picnic-offer{grid-template-columns:1fr;gap:20px;margin-block:24px 36px;padding:24px}.picnic-offer-art{max-width:280px}.picnic-offer-actions{align-items:stretch;flex-direction:column}.picnic-offer-actions a{width:100%;justify-content:center}}
</style>
