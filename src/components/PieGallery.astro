---
import { getImage } from 'astro:assets';
import type { Product } from '../data/catalog';
import { pieCutaway } from '../data/pie-cutaways';
interface Props { product: Product; href?: string; class?: string; hero?: boolean; sizes?: string }
const { product, href, class: className, hero = false, sizes = '(max-width:600px) 130px, 240px' } = Astro.props;
const cutaway = pieCutaway(product.id);
const widths = hero ? [320, 480, 800] : [160, 280, 480];
const images = cutaway ? await Promise.all(widths.map(width => getImage({ src: cutaway.image, width, format: 'webp', quality: 72 }))) : [];
---
{cutaway ? <div class:list={[className, 'pie-gallery', { 'pie-gallery--hero': hero }]} data-pie-gallery={product.id}>
  {href ? <a class="pie-gallery-original product-visual-link" href={href} aria-label={`Подробнее: ${product.name}`}><slot /></a> : <div class="pie-gallery-original"><slot /></div>}
  <div class="pie-gallery-cutaway" data-cutaway-image hidden></div>
  <template data-cutaway-template><img src={images[1].src} srcset={images.map((img, index) => `${img.src} ${widths[index]}w`).join(', ')} {sizes} width={cutaway.image.width} height={cutaway.image.height} alt={cutaway.alt} decoding="async" /></template>
  <button class="pie-gallery-toggle" type="button" data-cutaway-toggle hidden aria-pressed="false" aria-label={`Показать начинку: ${product.name}`}><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg><span data-cutaway-label>Срез</span></button>
  <span class="sr-only" role="status" data-cutaway-status></span>
</div> : href ? <a class={className} {href} aria-label={`Подробнее: ${product.name}`}><slot /></a> : <slot />}
<script>import '../scripts/pie-gallery';</script>
<style>
  .pie-gallery{position:relative;width:100%;aspect-ratio:1;isolation:isolate}
  .pie-gallery-original{display:block;width:100%;height:100%;border-radius:inherit}
  .pie-gallery-cutaway{position:absolute;inset:0;border-radius:inherit;background:var(--surface-oat);pointer-events:none}
  .pie-gallery-cutaway img{width:100%;height:100%;object-fit:contain;padding:5%;filter:drop-shadow(0 8px 8px #17263d12)}
  .pie-gallery-toggle{position:absolute;right:2px;bottom:2px;display:flex;align-items:center;justify-content:center;gap:5px;min-width:56px;min-height:44px;padding:6px 9px;border:1px solid var(--line);border-radius:24px;background:var(--paper-raised);color:var(--navy);box-shadow:0 2px 8px #17263d0a;font:500 10px/1.3 var(--sans);cursor:pointer;z-index:2}
  .pie-gallery-toggle[hidden],.pie-gallery-cutaway[hidden]{display:none}
  .pie-gallery-toggle[aria-pressed=true]{border-color:var(--navy);background:var(--navy);color:var(--paper)}
  .pie-gallery-toggle:focus-visible{outline:3px solid var(--focus);outline-offset:2px}
  .pie-gallery-toggle[aria-busy=true]{opacity:.7;cursor:progress}
  .sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
  .pie-gallery--hero .pie-gallery-toggle{right:10px;bottom:10px;font-size:13px;min-width:106px;padding-inline:16px}
</style>
