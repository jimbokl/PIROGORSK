---
interface Props { total: number }
const { total } = Astro.props;
---
<form class="blog-search" data-blog-search-form role="search" aria-label="Поиск по журналу">
  <label for="blog-query">Найдите полезное к столу</label>
  <div class="blog-search-row">
    <input id="blog-query" type="search" name="q" maxlength="100" autocomplete="off" placeholder="Начинка, подача или повод" enterkeyhint="search" aria-controls="blog-results" />
    <button class="ed-button" type="submit">Найти</button>
  </div>
  <div class="blog-search-meta">
    <p data-blog-search-status role="status" aria-live="polite" aria-atomic="true">Материалов в журнале: {total}</p>
    <button type="button" data-blog-search-reset hidden>Сбросить поиск</button>
  </div>
</form>
<script>import '../scripts/blog-search';</script>
