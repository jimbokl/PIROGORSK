---
const circles = [6, 8];
---
<section class="cutting-diagrams" aria-labelledby="cutting-diagrams-heading">
  <header><p class="ed-eyebrow">Сначала выберите размер кусочка</p><h2 id="cutting-diagrams-heading">Три понятные схемы нарезки</h2><p>Пирог <span data-cut-weight-label>1,2 кг</span>: делим массу на число кусков и получаем среднее.</p></header>
  <form class="cutting-controls" data-cut-controls hidden>
    <label>Масса из примера<select name="cut-weight"><option value="1000">1 кг</option><option value="1200" selected>1,2 кг</option><option value="1500">1,5 кг</option></select></label>
    <label>Частей на средней схеме<select name="cut-count"><option value="8">8 частей</option><option value="10">10 частей</option><option value="12">12 частей</option></select></label>
    <label>Прямоугольный пирог<select name="cut-rectangle"><option value="3">9 кусков · 3 × 3</option><option value="4" selected>12 кусков · 3 × 4</option></select></label>
    <label>Масса своего пирога, г<input name="cut-custom-weight" type="number" inputmode="numeric" min="1" max="99999" step="1" placeholder="Например, 1080" aria-describedby="cut-weight-note"></label>
  </form>
  <p id="cut-weight-note" class="cut-weight-note" hidden>Если поле пустое, используется выбранная масса из примера.</p>
  <div class="cutting-grid">
    {circles.map((count,index) => <figure data-cut-parts={count} data-cut-variable={index === 1 ? '' : undefined}>
      <svg viewBox="0 0 240 190" role="img" aria-label={`Круглый пирог: ${count} равных секторов`}>
        <circle class="crust" cx="120" cy="95" r="76" />
        <circle class="filling" cx="120" cy="95" r="66" />
        {Array.from({ length: count }, (_, i) => { const a = (i * 2 * Math.PI / count) - Math.PI / 2; return <line x1="120" y1="95" x2={120 + 76 * Math.cos(a)} y2={95 + 76 * Math.sin(a)} />; })}
        <circle class="center" cx="120" cy="95" r="4" />
      </svg>
      <figcaption><strong data-cut-count-label>{count} кусочков</strong><span data-cut-mass>≈ {1200 / count} г каждый</span></figcaption>
    </figure>)}
    <figure data-cut-parts="12" data-cut-rectangle>
      <svg viewBox="0 0 240 190" role="img" aria-label="Прямоугольный пирог: три ряда по четыре равных кусочка">
        <rect class="crust" x="22" y="28" width="196" height="134" rx="12" />
        <rect class="filling" x="32" y="38" width="176" height="114" rx="5" />
        {[1,2,3].map(i => <line data-cut-column x1={22 + i * 49} y1="28" x2={22 + i * 49} y2="162" />)}
        {[1,2].map(i => <line x1="22" y1={28 + i * 134/3} x2="218" y2={28 + i * 134/3} />)}
      </svg>
      <figcaption><strong data-cut-grid-label>12 кусков · 3 × 4</strong><span data-cut-mass>≈ 100 г каждый</span></figcaption>
    </figure>
  </div>
  <p class="cutting-status" data-cut-status role="status" aria-live="polite" aria-atomic="true"></p>
  <aside class="cutting-example" aria-label="Пример расчёта по показанию весов">
    <svg viewBox="0 0 170 100" aria-hidden="true" focusable="false">
      <rect x="10" y="37" width="150" height="52" rx="15" fill="#ecd2a4" stroke="#bd8c51" />
      <path d="M36 24h98l-13 13H49Z" fill="#f8edda" stroke="#bd8c51" />
      <rect x="60" y="54" width="50" height="23" rx="5" fill="#253750" />
      <text x="85" y="69" text-anchor="middle" fill="#fff" font-size="11" font-family="system-ui">1080 г</text>
    </svg>
    <p><strong>Пример: на весах 1080 г</strong><br />Без массы блюда: 1080 ÷ 9 = 120 г; 1080 ÷ 12 = 90 г. Сравниваем две нарезки одного и того же пирога.</p>
  </aside>
  <p class="cutting-note">Для общего стола нарежьте часть пирога, оставив остальные кусочки крупнее. Сытные и сладкие начинки удобно поставить на разные блюда, а лопатку положить рядом с каждым.</p>
</section>
<script>
  const diagram = document.querySelector<HTMLElement>('.cutting-diagrams');
  const controls = diagram?.querySelector<HTMLFormElement>('[data-cut-controls]');
  if (diagram && controls) {
    const weightInput = controls.querySelector<HTMLSelectElement>('[name="cut-weight"]')!;
    const countInput = controls.querySelector<HTMLSelectElement>('[name="cut-count"]')!;
    const rectangleInput = controls.querySelector<HTMLSelectElement>('[name="cut-rectangle"]')!;
    const customInput = controls.querySelector<HTMLInputElement>('[name="cut-custom-weight"]')!;
    const weightNote = diagram.querySelector<HTMLElement>('#cut-weight-note')!;
    const rectangle = diagram.querySelector<HTMLElement>('[data-cut-rectangle]')!;
    const rectangleSvg = rectangle.querySelector('svg')!;
    const columnTemplate = rectangleSvg.querySelector('[data-cut-column]')!;
    const variable = diagram.querySelector<HTMLElement>('[data-cut-variable]')!;
    const svg = variable.querySelector('svg')!;
    const cutLine = svg.querySelector('line')!;
    const format = new Intl.NumberFormat('ru-RU', { maximumFractionDigits: 1 });
    const render = () => {
      if (!customInput.validity.valid) {
        customInput.setAttribute('aria-invalid', 'true');
        weightNote.textContent = 'Введите целое число от 1 до 99 999 г. Пока показывается предыдущий расчёт.';
        diagram.querySelector('[data-cut-status]')!.textContent = weightNote.textContent;
        return;
      }
      customInput.removeAttribute('aria-invalid');
      weightNote.textContent = 'Если поле пустое, используется выбранная масса из примера.';
      const hasCustomWeight = customInput.value !== '';
      const weight = hasCustomWeight ? customInput.valueAsNumber : Number(weightInput.value);
      const weightLabel = hasCustomWeight ? `${format.format(weight)} г` : `${format.format(weight / 1000)} кг`;
      const count = Number(countInput.value), columns = Number(rectangleInput.value);
      const rectangleParts = 3 * columns;
      rectangle.dataset.cutParts = String(rectangleParts);
      rectangle.querySelector('[data-cut-grid-label]')!.textContent = `${rectangleParts} кусков · 3 × ${columns}`;
      rectangleSvg.setAttribute('aria-label', `Прямоугольный пирог: 3 ряда по ${columns} куска`);
      rectangleSvg.querySelectorAll('[data-cut-column]').forEach(line => line.remove());
      for (let i = 1; i < columns; i++) {
        const line = columnTemplate.cloneNode(false) as SVGLineElement;
        const x = String(22 + i * 196 / columns);
        line.setAttribute('x1', x);
        line.setAttribute('x2', x);
        rectangleSvg.append(line);
      }
      variable.dataset.cutParts = String(count);
      variable.querySelector('[data-cut-count-label]')!.textContent = `${count} кусочков`;
      svg.setAttribute('aria-label', `Круглый пирог: ${count} равных секторов`);
      svg.querySelectorAll('line').forEach(line => line.remove());
      const center = svg.querySelector('.center')!;
      for (let i = 0; i < count; i++) {
        const angle = i * 2 * Math.PI / count - Math.PI / 2;
        // Retain Astro's scoped style attribute when rebuilding the sectors.
        const line = cutLine.cloneNode(false) as SVGLineElement;
        for (const [key, value] of Object.entries({ x1:120, y1:95, x2:120 + 76 * Math.cos(angle), y2:95 + 76 * Math.sin(angle) })) line.setAttribute(key, String(value));
        svg.insertBefore(line, center);
      }
      diagram.querySelector('[data-cut-weight-label]')!.textContent = weightLabel;
      const summaries: string[] = [];
      diagram.querySelectorAll<HTMLElement>('[data-cut-parts]').forEach(figure => {
        const parts = Number(figure.dataset.cutParts), mass = format.format(weight / parts);
        figure.querySelector('[data-cut-mass]')!.textContent = `≈ ${mass} г каждый`;
        summaries.push(`${figure === rectangle ? 'прямоугольный' : 'круглый'}, ${parts} кусков по ${mass} г`);
      });
      diagram.querySelector('[data-cut-status]')!.textContent = `Масса ${weightLabel}: ${summaries.join('; ')}. Средняя масса, без взвешивания отдельных кусков.`;
    };
    controls.addEventListener('submit', event => { event.preventDefault(); render(); });
    controls.addEventListener('change', render);
    controls.hidden = false;
    weightNote.hidden = false;
  }
</script>
<style>
  .cutting-diagrams{padding-block:30px 36px;margin-block:20px;border-block:1px solid var(--line)}
  header{max-width:690px}h2{font:500 clamp(27px,3vw,38px)/1.18 var(--serif);letter-spacing:-.03em;margin:8px 0 14px}
  p{font:400 14px/1.8 var(--sans);color:var(--muted);margin:0}
  .cutting-controls{display:flex;flex-wrap:wrap;gap:16px 24px;margin-top:22px}.cutting-controls[hidden]{display:none}.cutting-controls label{display:grid;gap:8px;font:500 13px/1.5 var(--sans);color:var(--navy);flex:1 1 180px;max-width:300px;min-width:0}.cutting-controls :is(select,input){box-sizing:border-box;width:100%;min-height:46px;padding:10px 34px 10px 14px;border:1px solid var(--line);border-radius:12px;background:var(--soft);color:var(--navy);font:500 16px/1.5 var(--sans)}.cutting-controls :is(select,input):focus-visible{outline:2px solid var(--navy);outline-offset:4px}.cutting-status{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
  .cutting-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin-block:24px}
  figure{margin:0;padding:12px 14px 20px;border:1px solid var(--line);border-radius:var(--radius-card);background:var(--soft)}
  svg{display:block;width:100%;height:auto}.crust{fill:#ecd2a4;stroke:#bd8c51;stroke-width:1.5}.filling{fill:#f8edda;stroke:#d5ae76;stroke-width:1}line{stroke:var(--navy);stroke-width:1.5;stroke-linecap:round}.center{fill:var(--navy)}
  figcaption{display:flex;flex-direction:column;gap:4px;text-align:center}strong{font:500 15px/1.5 var(--sans);color:var(--navy)}span{font:400 12px/1.5 var(--sans);color:var(--muted)}
  .cutting-note{max-width:720px}
  .cut-weight-note{margin-top:8px}
  .cutting-example{display:grid;grid-template-columns:minmax(75px,120px) minmax(0,1fr);gap:14px;align-items:center;margin-block:18px;padding:10px 14px;border:1px solid var(--line);border-radius:var(--radius-card);background:var(--soft)}
  @media(max-width:600px){.cutting-grid{grid-template-columns:1fr;gap:12px}figure{display:grid;grid-template-columns:minmax(0,1fr) minmax(90px,.8fr);align-items:center;padding:8px 14px}figcaption{text-align:left}svg{max-width:220px}.cutting-diagrams{padding-block:24px}}
</style>
