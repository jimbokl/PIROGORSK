---
import { Picture } from 'astro:assets';
import { articleHref, type BlogEntry } from '../data/blog';
interface Props { entries: readonly BlogEntry[] }
const { entries } = Astro.props;
---
<div class:list={['blog-card-grid', { 'blog-card-grid-single': entries.length === 1, 'blog-card-grid-even': entries.length === 4 }]}>{entries.map(entry => <article class="blog-card"><a href={articleHref(entry.slug)}><div class="blog-card-image"><Picture src={entry.image} formats={['avif', 'webp']} fallbackFormat="webp" widths={[360, 480, 680, 960]} sizes={entries.length === 1 || entries.length === 4 ? '(max-width: 650px) calc(100vw - 36px), (min-width: 1240px) 560px, 44vw' : '(max-width: 650px) calc(100vw - 36px), (min-width: 1240px) 360px, (max-width: 900px) 44vw, 30vw'} width={640} height={427} quality={48} alt={entry.imageAlt} loading="lazy" decoding="async" /></div><h3>{entry.title}<span aria-hidden="true">↗</span></h3><div class="blog-card-meta"><span>{entry.category}</span><span>≈ {entry.minutes} мин</span></div><p>{entry.description}</p></a></article>)}</div>
<style>
  .blog-card-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--card-gap);align-items:stretch}
  .blog-card{min-width:0;display:grid;grid-template-rows:subgrid;grid-row:span 4;border:1px solid var(--card-line);border-radius:var(--radius-card);background:var(--paper-raised);padding:8px 8px 22px;row-gap:0}
  .blog-card a{display:grid;grid-template-rows:subgrid;grid-row:span 4;row-gap:0;color:inherit;text-decoration:none;min-width:0}
  .blog-card a:focus-visible{outline:3px solid var(--focus);outline-offset:5px;border-radius:var(--radius-image)}
  .blog-card-image{aspect-ratio:3/2;overflow:hidden;border-radius:var(--radius-image);background:var(--editorial-image-surface)}
  .blog-card-image img{display:block;width:100%;height:100%;object-fit:cover}
  .blog-card-meta{display:flex;justify-content:space-between;align-items:start;gap:15px;padding:0 12px 14px;font-size:12px;line-height:1.6;color:var(--muted)}
  .blog-card-meta>span:first-child{color:var(--coral-ink)}
  .blog-card h3{display:flex;justify-content:space-between;gap:10px;font:600 var(--heading-card)/1.2 var(--serif);letter-spacing:-.035em;margin:0;padding:18px 12px 14px}
  .blog-card h3 span{font:20px/1.5 var(--sans);flex-shrink:0}
  .blog-card p{font-size:14px;line-height:1.75;color:var(--muted);max-width:65ch;padding:0 12px;margin:0}
  .blog-card a:hover h3{text-decoration:underline;text-underline-offset:5px;text-decoration-thickness:1px}
  .blog-card-grid-even{grid-template-columns:repeat(2,minmax(0,1fr))}
  .blog-card-grid-single{grid-template-columns:minmax(0,1fr)}
  .blog-card-grid-single .blog-card{grid-template-rows:auto;padding-bottom:8px}
  .blog-card-grid-single .blog-card a{grid-template-columns:repeat(2,minmax(0,1fr));grid-template-rows:auto auto 1fr;gap:0 20px;grid-row:auto}
  .blog-card-grid-single .blog-card-image{grid-row:1/4}
  @media(max-width:900px){.blog-card-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.blog-card-grid-single{grid-template-columns:minmax(0,1fr)}}
  @media(max-width:650px){.blog-card-grid{grid-template-columns:minmax(0,1fr)}.blog-card-grid-single .blog-card{grid-template-rows:subgrid;padding-bottom:22px}.blog-card-grid-single .blog-card a{grid-template-columns:minmax(0,1fr);grid-template-rows:subgrid;grid-row:span 4}.blog-card-grid-single .blog-card-image{grid-row:auto}}
</style>
