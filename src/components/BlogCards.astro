---
import { Picture } from 'astro:assets';
import { articleHref, type BlogEntry } from '../data/blog';
interface Props { entries: readonly BlogEntry[] }
const { entries } = Astro.props;
---
<div class:list={['blog-card-grid', { 'blog-card-grid-single': entries.length === 1, 'blog-card-grid-even': entries.length === 4 }]}>{entries.map(entry => <article class="blog-card"><a href={articleHref(entry.slug)}><div class="blog-card-image"><Picture src={entry.image} formats={['avif', 'webp']} fallbackFormat="webp" widths={[400, 640, 800]} sizes={entries.length === 1 || entries.length === 4 ? '(max-width: 650px) 90vw, 44vw' : '(max-width: 650px) 90vw, (max-width: 900px) 44vw, 30vw'} width={640} height={427} quality={52} alt={entry.imageAlt} loading="lazy" decoding="async" /></div><div class="blog-card-meta"><span>{entry.category}</span><span>≈ {entry.minutes} мин</span></div><h3>{entry.title}<span aria-hidden="true">↗</span></h3><p>{entry.description}</p></a></article>)}</div>
<style>
  .blog-card-grid-single{grid-template-columns:1fr!important}.blog-card-grid-even{grid-template-columns:repeat(2,minmax(0,1fr))!important}.blog-card-grid-single .blog-card a{display:grid;grid-template-columns:1fr 1fr;grid-template-rows:auto auto 1fr;column-gap:38px}.blog-card-grid-single .blog-card-image{grid-row:1/4}.blog-card-grid-single .blog-card-meta{margin-top:20px}.blog-card-grid-single .blog-card h3{font-size:34px}.blog-card-grid-single .blog-card p{font-size:13px}@media(max-width:650px){.blog-card-grid-single .blog-card a{display:block}.blog-card-grid-even{grid-template-columns:1fr!important}.blog-card-grid-single .blog-card h3{font-size:28px}}
  .blog-card-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:38px 26px}.blog-card{min-width:0}.blog-card a{display:block;color:inherit;text-decoration:none}.blog-card a:focus-visible{outline:2px solid #a55112;outline-offset:8px}.blog-card-image{aspect-ratio:3/2;overflow:hidden;background:#ece8dd}.blog-card-image img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .25s}.blog-card a:hover img{transform:scale(1.025)}.blog-card-meta{display:flex;justify-content:space-between;gap:15px;margin-top:20px;font-size:10px;line-height:1.6;color:#526970}.blog-card-meta>span:first-child{color:#a55112;letter-spacing:.08em;text-transform:uppercase}.blog-card h3{display:flex;justify-content:space-between;gap:10px;font:500 26px/1.23 var(--serif,Georgia,serif);letter-spacing:-.02em;margin:12px 0}.blog-card h3 span{font:20px/1.5 var(--sans,Arial,sans-serif);color:#a55112;flex-shrink:0}.blog-card p{font-size:12px;line-height:1.85;color:#526970;max-width:55ch}.blog-card a:hover h3{text-decoration:underline;text-underline-offset:5px;text-decoration-thickness:1px}@media(max-width:900px){.blog-card-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:650px){.blog-card-grid{grid-template-columns:1fr;gap:34px}.blog-card h3{font-size:28px}.blog-card-meta{margin-top:17px}.blog-card p{font-size:13px}}@media(prefers-reduced-motion:reduce){.blog-card-image img{transition:none}.blog-card a:hover img{transform:none}}
</style>
