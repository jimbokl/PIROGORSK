---
import { placesForCity, cityNames, rub, type CitySlug } from '../data/local-data';
import { products } from '../data/catalog';
import { planPies } from '../lib/pie-planner';
interface Props { city: CitySlug }
const { city } = Astro.props;
const places = placesForCity(city);
const priced = places.filter(place => place.familyOf4DinnerRub !== null);
const examples = priced.length ? priced.slice(0, 2) : places.slice(0, 2);
const plan = planPies(4, 350, ['meat', 'cabbage'], products);
---
<section class="guide-summary" aria-label={`Краткое сравнение еды: ${cityNames[city]}`}>
  <div class="guide-summary-scroll" tabindex="0" role="region" aria-label="Краткая таблица: формат, бюджет на четверых и время получения">
    <table>
      <caption>На четверых: примеры без напитков и доставки</caption>
      <thead><tr><th scope="col">Вариант</th><th scope="col">Бюджет</th><th scope="col">Когда получить</th></tr></thead>
      <tbody>
        {examples.map(place => <tr><th scope="row"><a href={place.sources[0].url}>{place.name} ↗</a><small>{place.category}</small></th><td>{place.familyOf4DinnerRub === null ? 'Нет проверенной корзины' : <><strong>{rub(place.familyOf4DinnerRub)}</strong><small>Четыре блюда, состав ниже</small></>}</td><td>Уточнить в заведении</td></tr>)}
        <tr class="guide-summary-project"><th scope="row">Пирогорск<small>Пример: 1,5 кг пирогов</small></th><td><strong>{rub(plan.total)}</strong><small>Предварительная цена</small></td><td>Готовим запуск<small>Доставки пока нет</small></td></tr>
      </tbody>
    </table>
  </div>
  <a class="guide-summary-more" href="#places-comparison">Все {places.length} адресов, состав корзин и источники ↓</a>
</section>
<style>
.guide-summary{margin:0 0 32px}.guide-summary-scroll{overflow-x:auto;border:1px solid var(--ed-line);background:#fffdf9}.guide-summary table{border-collapse:collapse;width:100%;min-width:430px;font-size:12px;line-height:1.65}.guide-summary caption{text-align:left;font-size:11px;color:var(--ed-muted);padding:12px 16px}.guide-summary th,.guide-summary td{text-align:left;vertical-align:top;border-top:1px solid var(--ed-line);padding:12px 16px;font-weight:400}.guide-summary thead th{font-size:10px;text-transform:uppercase;letter-spacing:.06em}.guide-summary tbody th{width:36%}.guide-summary strong{font-weight:500;white-space:nowrap}.guide-summary small{display:block;font-size:10px;color:var(--ed-muted);margin-top:4px}.guide-summary-project{background:var(--ed-sea)}.guide-summary-more{display:inline-flex;align-items:center;min-height:44px;margin-top:3px;font-size:11px;text-underline-offset:4px}
@media(max-width:760px){.guide-summary{margin-bottom:25px}.guide-summary table{min-width:0;table-layout:fixed;font-size:11px;overflow-wrap:anywhere}.guide-summary th,.guide-summary td{padding:10px 8px}.guide-summary caption{padding:10px 8px}.guide-summary small{font-size:9px}.guide-summary tbody th{width:auto}}
</style>
