      <rect class="wrap" x="260" y="41" width="51" height="32" rx="6"/><rect class="filling" x="256" y="36" width="59" height="7" rx="3"/><rect class="label" x="278" y="48" width="25" height="13" rx="2"/><path class="arrow" d="M282 53h16m-16 4h11"/>
