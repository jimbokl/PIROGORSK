---
import { supplierArtwork } from '../data/supplier-artwork';
interface Props { id: string; hero?: boolean; decorative?: boolean }
const { id, hero = false, decorative = false } = Astro.props;
const art = supplierArtwork(id);
const sizes = hero ? '(max-width: 760px) 250px, (max-width: 1100px) 46vw, 520px' : '(max-width: 650px) calc(100vw - 80px), (max-width: 1050px) 42vw, 360px';
const srcset = (extension: string) => art.widths.map(width => `${art.base}-${width}.${extension} ${width}w`).join(', ');
---
<picture class="supplier-artwork" data-supplier-artwork={id}>
  <source type="image/avif" srcset={srcset('avif')} {sizes} />
  <img src={`${art.base}-400.webp`} srcset={srcset('webp')} {sizes} width="960" height="960" alt={decorative ? '' : art.alt} loading={hero ? 'eager' : 'lazy'} fetchpriority={hero ? 'high' : 'auto'} decoding="async" />
</picture>
<style>.supplier-artwork{display:block;aspect-ratio:1;background:#fbf9f4;overflow:hidden;border-radius:10px}.supplier-artwork img{display:block;width:100%;height:auto;aspect-ratio:1;object-fit:contain}</style>
