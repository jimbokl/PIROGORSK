---
interface Props {
  taste: string;
  links: { href: string; title: string }[];
}
const { taste, links } = Astro.props;
---
<section class="product-notes" aria-label="Вкус и сочетания" data-product-notes>
  <div class="taste"><h2>О вкусе</h2><p>{taste}</p></div>
  <div class="pairings"><h2>Хорошая пара</h2><div class="pairing-links">{links.map(link => <a href={link.href}>{link.title}<span aria-hidden="true">↗</span></a>)}</div></div>
</section>
<style>
  .product-notes{display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,4vw,56px);padding:clamp(22px,3vw,36px);margin-block:12px 40px;border:1px solid var(--brand-line);border-radius:var(--radius-card);background:var(--brand-paper)}
  h2{font:600 13px/1.5 var(--sans);color:var(--brand-ink);margin:0 0 10px}
  p{font:400 clamp(16px,1.5vw,19px)/1.6 var(--sans);max-width:40ch;margin:0;color:var(--navy)}
  .pairing-links{display:flex;flex-wrap:wrap;gap:8px}
  a{display:inline-flex;align-items:center;justify-content:space-between;gap:16px;min-height:44px;padding:10px 14px;background:#fff;border:1px solid var(--brand-line);border-radius:var(--radius-control);color:var(--navy);font:500 14px/1.5 var(--sans);text-decoration:none;transition:border-color .2s,background .2s}
  a:hover{border-color:var(--brand-gold);background:#fff8eb}a:focus-visible{outline:2px solid var(--accent);outline-offset:3px}a span{color:var(--brand-ink);flex-shrink:0}
  @media(max-width:760px){.product-notes{grid-template-columns:1fr;gap:22px;margin-bottom:28px}.pairing-links{flex-direction:column}a{gap:12px}}
  @media(prefers-reduced-motion:reduce){a{transition:none}}
</style>
