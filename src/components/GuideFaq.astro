---
interface Props {faq:readonly {question:string;answer:string}[]}
const {faq}=Astro.props;
---
<section class="guide-faq"><p class="ed-eyebrow">Перед выбором</p><h2>Частые вопросы</h2>{faq.map(f=><details><summary>{f.question}</summary><p>{f.answer}</p></details>)}</section>
<style>
  .guide-faq{margin:42px 0}
  .guide-faq h2{font:400 clamp(28px,4vw,38px)/1.2 var(--ed-serif);margin:12px 0 24px}
  .guide-faq details{margin-top:10px;padding:0 22px;border:1px solid var(--brand-line);border-radius:18px;background:var(--paper-raised)}
  .guide-faq details[open]{background:var(--brand-paper)}
  .guide-faq summary{display:flex;align-items:center;justify-content:space-between;gap:20px;min-height:64px;padding-block:16px;list-style:none;font:500 15px/1.6 var(--sans);cursor:pointer}
  .guide-faq summary::-webkit-details-marker{display:none}
  .guide-faq summary::after{content:'+';display:grid;place-items:center;flex:none;width:30px;height:30px;border:1px solid var(--brand-line);border-radius:50%;color:var(--brand-ink);font:400 22px/1 var(--sans)}
  .guide-faq details[open] summary::after{content:'−'}
  .guide-faq summary:focus-visible{outline:3px solid var(--focus);outline-offset:4px;border-radius:8px}
  .guide-faq details p{font-size:14px;line-height:1.85;max-width:760px;margin:0;padding-bottom:22px;color:var(--muted)}
  @media(max-width:600px){.guide-faq details{padding-inline:18px}.guide-faq summary{gap:14px;font-size:14px}}
</style>
