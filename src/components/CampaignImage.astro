---
import type { ImageMetadata } from 'astro';
import { campaignImage, phoneCampaignSizes, wideCampaignSizes } from '../lib/campaign-images';
interface Props { image: ImageMetadata; alt: string; priority?: boolean }
const { image, alt, priority = false } = Astro.props;
// The phone shows the right-hand scene. Export that crop rather than downloading
// a wide panorama and discarding most of it with CSS.
const [phoneAvif, phoneWebp, wideAvif, wideWebp] = await Promise.all([
  campaignImage(image, true, 'avif'), campaignImage(image, true, 'webp'),
  campaignImage(image, false, 'avif'), campaignImage(image, false, 'webp'),
]);
---
<picture>
  <source media="(max-width: 480px)" type="image/avif" srcset={phoneAvif.srcSet.attribute} sizes={phoneCampaignSizes} />
  <source media="(max-width: 480px)" type="image/webp" srcset={phoneWebp.srcSet.attribute} sizes={phoneCampaignSizes} />
  <source type="image/avif" srcset={wideAvif.srcSet.attribute} sizes={wideCampaignSizes} />
  <img src={wideWebp.src} srcset={wideWebp.srcSet.attribute} sizes={wideCampaignSizes} width={1920} height={640} alt={alt} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'low'} decoding="async" />
</picture>
