---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import manifestData from '../../design/layered-assets-v2/manifest.json';
import tablewareProduct from '../../design/product-backdrops-source/tableware-product.png';
import type { Product } from '../data/catalog';
import ProductBadge from './ProductBadge.astro';
import ProductBackdrop from './ProductBackdrop.astro';
import { productBackdrop } from '../data/product-backdrops';
import '../styles/catalog.css';

interface Props { product: Product; layout?: 'catalog' | 'menu' | 'hero'; decorative?: boolean }
type AssetFile = { path?: string; status?: string; alpha?: boolean };
type AssetEntry = {
  status?: string;
  files?: { pie?: AssetFile; product?: AssetFile; image?: AssetFile; cutout?: AssetFile; background?: AssetFile };
  composition?: {
    pie_css_width_percent?: number; pie_center_x_percent?: number; pie_center_y_percent?: number;
    product_css_height_percent?: number; product_center_x_percent?: number; product_center_y_percent?: number;
  };
};
const { product, layout = 'catalog', decorative = false } = Astro.props;
const manifest = manifestData as { pairs?: Record<string, AssetEntry>; drinks?: Record<string, AssetEntry> };
const images = import.meta.glob<ImageMetadata>('../../design/layered-assets-v2/**/*.{png,webp,avif}', { eager: true, import: 'default' });
const legacyImages = import.meta.glob<ImageMetadata>('../../design/assets-source/{meat,fish,cabbage,cheese}.png', { eager: true, import: 'default' });
const asset = (file?: AssetFile) => file?.path && file.status === 'READY' ? images[`../../design/layered-assets-v2/${file.path}`] : undefined;
const entry = (product.kind === 'pie' ? manifest.pairs : manifest.drinks)?.[product.visualKey ?? product.id];
const ready = entry?.status === 'READY';
const background = ready ? asset(entry.files?.background) : undefined;
const generatedBackdrop = productBackdrop(product.id);
const subjectFile = entry?.files?.pie ?? entry?.files?.product ?? entry?.files?.image ?? entry?.files?.cutout;
const subject = product.id === 'tableware' ? tablewareProduct : ready && subjectFile?.alpha === true ? asset(subjectFile) : undefined;
const layered = subject && (product.kind !== 'pie' || background);
const legacy = product.kind === 'pie' ? legacyImages[`../../design/assets-source/${product.id}.png`] : undefined;
const composition = entry?.composition;
const imageState = layered || generatedBackdrop ? 'ready' : legacy ? 'legacy' : 'pending';
const subjectWidth = product.kind === 'pie' ? composition?.pie_css_width_percent ?? 88 : composition?.product_css_height_percent ?? 88;
const subjectX = product.kind === 'pie' ? composition?.pie_center_x_percent ?? 50 : composition?.product_center_x_percent ?? 50;
const subjectY = product.kind === 'pie' ? composition?.pie_center_y_percent ?? 54 : composition?.product_center_y_percent ?? 50;
const position = `--subject-width:${subjectWidth}%;--subject-x:${subjectX}%;--subject-y:${subjectY}%;`;
const imageWidths = layout === 'hero' ? [320, 480, 640, 700, 800, 1200] : [240, 280, 320, 400, 480, 600, 800];
// Match each grid's columns, gaps and container. The transparent layer occupies
// only part of that slot, so it needs its own sizes rather than the background's.
type Slot = [breakpoint: number, vw: number, pixels: number];
const slots: Slot[] = layout === 'hero'
  ? [[420, 100, -36], [760, 100, -48], [1000, 51.9231, -39.4615], [1300, 51.9231, -69.5769], [Infinity, 0, 605.4231]]
  : layout === 'menu'
    ? [[420, 100, -36], [760, 50, -33], [1000, 100 / 3, -88 / 3], [1300, 100 / 3, -136 / 3], [Infinity, 0, 388]]
    : [[380, 100, -36], [600, 50, -28], [850, 50, -51], [1060, 100 / 3, -44],
      ...(product.kind === 'drink'
        ? [[1200, 100 / 3, -60], [1400, 20, -41.6], [Infinity, 0, 238.4]] as Slot[]
        : [[1400, 25, -51], [Infinity, 0, 299]] as Slot[])];
const slotSizes = (scale = 1) => slots.map(([breakpoint, vw, pixels]) => {
  const length = vw === 0 ? `${+(pixels * scale).toFixed(3)}px`
    : `calc(${+(vw * scale).toFixed(3)}vw - ${+(-pixels * scale).toFixed(3)}px)`;
  const boundedLength = layout === 'hero' ? `min(${length}, ${+(520 * scale).toFixed(3)}px)` : length;
  return `${Number.isFinite(breakpoint) ? `(max-width: ${breakpoint}px) ` : ''}${boundedLength}`;
}).join(', ');
const accessoryThumbnail = product.kind === 'accessory' && layout === 'catalog';
const accessorySizes = (scale = 1) => `(max-width: 600px) ${80 * scale}px, (max-width: 850px) ${96 * scale}px, ${112 * scale}px`;
const sizes = accessoryThumbnail ? accessorySizes() : slotSizes();
const subjectSizes = accessoryThumbnail ? accessorySizes(subjectWidth / 100) : slotSizes(subjectWidth / 100);
const loading = layout === 'hero' ? 'eager' : 'lazy';
const fetchpriority = layout === 'hero' ? 'high' : 'auto';
---
<div class:list={['product-visual', `product-visual--${product.kind}`, { 'product-visual--pending': imageState === 'pending', 'product-visual--hero': layout === 'hero' }]} data-image-state={imageState} style={position} aria-hidden={decorative ? 'true' : undefined}>
  {generatedBackdrop && <ProductBackdrop id={product.id} {sizes} hero={layout === 'hero'} />}
  {layered ? <>
    {background && <Picture src={background} formats={['avif', 'webp']} fallbackFormat="webp" widths={imageWidths} sizes={sizes} width={600} height={600} quality={44} alt="" class="product-visual-background" loading={loading} fetchpriority={fetchpriority} decoding="async" />}
    <Picture src={subject!} formats={['avif', 'webp']} fallbackFormat="webp" widths={imageWidths} sizes={subjectSizes} width={600} height={600} quality={58} alt={product.kind === 'pie' ? `${product.name}: пирог и кусочек с начинкой` : product.name} class="product-visual-subject" loading={loading} fetchpriority={fetchpriority} decoding="async" />
  </> : legacy ? <Picture src={legacy} formats={['avif', 'webp']} fallbackFormat="webp" widths={imageWidths} sizes={sizes} width={600} height={532} quality={48} alt={`${product.name} и кусочек с начинкой`} class="product-visual-legacy" loading="lazy" decoding="async" /> : !generatedBackdrop && <div class="product-visual-placeholder" aria-hidden="true">
    <span class="product-placeholder-caption">Скоро в Пирогорске</span>
    <span class="product-placeholder-name">{product.kind === 'pie' ? 'Кусочек' : 'К вашему'}<br />{product.kind === 'pie' ? 'сладкого' : 'пирогу'}</span>
    <span class="product-placeholder-note">Изображение готовится</span>
  </div>}
  {product.badge && <ProductBadge kind={product.badge} class="product-visual-badge" />}
</div>
<script>import '../scripts/product-artwork';</script>
