---
import {placesForCity,cityNames,type CitySlug} from '../data/local-data';
interface Props {city:CitySlug}
const {city}=Astro.props;
const places=placesForCity(city).filter(p=>p.coords);
const lats=places.map(p=>p.coords![0]),lons=places.map(p=>p.coords![1]);
const latMin=Math.min(...lats)-.004,latMax=Math.max(...lats)+.004,lonMin=Math.min(...lons)-.008,lonMax=Math.max(...lons)+.008;
const x=(lon:number)=>60+(lon-lonMin)/(lonMax-lonMin)*600;
const y=(lat:number)=>230-(lat-latMin)/(latMax-latMin)*190;
---
<section class="place-map"><p class="ed-eyebrow">{cityNames[city]} · координаты из источников</p><h2>Ориентир на схеме</h2><p>Показаны {places.length} из {placesForCity(city).length} мест: только те, для которых источник публикует координаты. Это схема расположения без улиц и маршрутизации.</p>
<svg viewBox="0 0 720 280" role="img" aria-label={`Схема координат: ${places.map(p=>p.name).join(', ')}`}><rect x="1" y="1" width="718" height="278" fill="#eaf2ef" stroke="#b4c8c1" />{[60,160,260,360,460,560,660].map(n=><path d={`M${n} 25V250`} stroke="#ccdcd6"/>)}{[40,90,140,190,240].map(n=><path d={`M40 ${n}H680`} stroke="#ccdcd6"/>)}<text x="25" y="30" font-size="12" fill="#23483e">С ↑</text>{places.map((p,i)=><g><circle cx={x(p.coords![1])} cy={y(p.coords![0])} r="17" fill="#23483e"/><text x={x(p.coords![1])} y={y(p.coords![0])+5} text-anchor="middle" font-size="14" fill="#fff">{i+1}</text></g>)}</svg>
<ol>{places.map(p=><li><strong>{p.name}</strong> · {p.address} · <a href={`https://yandex.ru/maps/?pt=${p.coords![1]},${p.coords![0]}&z=16&l=map`} target="_blank" rel="noopener noreferrer">Открыть карту ↗</a><small>Координаты: {p.coords!.join(', ')} · <a href={p.sources.find(s=>s.fields.includes('coords'))!.url}>источник</a></small></li>)}</ol></section>
<style>.place-map{margin:38px 0;max-width:100%}.place-map h2{font:400 clamp(28px,4vw,38px)/1.2 var(--ed-serif);margin:12px 0}.place-map>p,.place-map li{font-size:13px;line-height:1.8}.place-map svg{display:block;width:100%;height:auto;margin:20px 0}.place-map ol{padding-left:22px}.place-map small{display:block;font-size:11px;overflow-wrap:anywhere}.place-map a{color:var(--ed-ink);text-underline-offset:4px}</style>
