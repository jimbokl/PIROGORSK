---
import SeoHead from '../components/SeoHead.astro';
import Analytics from '../components/Analytics.astro';
import Brand from '../components/Brand.astro';
import SiteNavigation from '../components/SiteNavigation.astro';
import { siteOrigin } from '../data/editorial';
import '../styles/editorial.css';
interface Props {
  title: string;
  description: string;
  breadcrumbs?: { name: string; href: string }[];
  schema?: Record<string, unknown>[];
  type?: 'website' | 'article';
  noindex?: boolean;
  image?: string;
  imageAlt?: string;
}
const { title, description, breadcrumbs = [], schema = [], type, noindex, image, imageAlt } = Astro.props;
const trail = [{ name: 'Главная', href: '/' }, ...breadcrumbs];
const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: item.name, item: new URL(item.href, siteOrigin).href })),
};
---
<!doctype html>
<html lang="ru">
  <head><SeoHead {title} {description} {type} {noindex} {image} {imageAlt} schema={[breadcrumbSchema, ...schema]} /><slot name="head" /></head>
  <body class="editorial-site">
    <Analytics />
    <a class="ed-skip" href="#content">Перейти к содержанию</a>
    <header class="ed-header ed-container">
      <Brand />
      <SiteNavigation />
    </header>
    <main id="content" class="ed-container">
      <nav class="ed-breadcrumbs" aria-label="Хлебные крошки"><ol>{trail.map((item, index) => <li>{index === trail.length - 1 ? <span aria-current="page">{item.name}</span> : <a href={item.href}>{item.name}</a>}</li>)}</ol></nav>
      <slot />
    </main>
    <footer class="ed-footer ed-container">
      <div><Brand footer /><p>Готовим запуск. Сейчас изучаем интерес<br class="ed-desktop-break" /> к вкусам, городам и форматам.</p></div>
      <nav aria-label="Дополнительная навигация"><a href="/menu/">Будущее меню</a><a href="/povody/">К случаю</a><a href="/delivery/">Города и условия</a><a href="/blog/">Блог</a><a href="/#pirogi">Отметить интерес</a></nav>
      <p class="ed-footnote">Изображения на сайте — иллюстрации концептов. Производство и продажи ещё не запущены.</p>
    </footer>
  </body>
</html>
